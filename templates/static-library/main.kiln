# A static library: no entry point. Link the archive into a host and call the
# exported subroutines, after calling `__MODULE___init` once. The build writes
# `__MODULE__.h` beside the archive — consumer.cpp includes it.
module __MODULE__
target staticlib

sub greet
  call print_text("Hello from a static library.")
end

sub add(a: int, b: int): int
  return a + b
end

sub greeting(name: text): text
  return "Hello, " + name + "!"
end
