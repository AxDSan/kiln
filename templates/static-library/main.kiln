// A static library: no entry point. Link the archive into a host and call the
// exported methods, after calling `__MODULE___init` once. Every `public static`
// method of a `public static class` is exported under its own name. The build
// writes `__MODULE__.h` beside the archive — consumer.cpp includes it.
//
//   kiln build main.kiln --target staticlib -o lib__MODULE__.a

namespace __MODULE__;

public static class Library
{
    public static void Greet()
    {
        Console.WriteLine("Hello from a static library.");
    }

    public static int Add(int a, int b) => a + b;

    public static string Greeting(string name) => $"Hello, {name}!";
}
