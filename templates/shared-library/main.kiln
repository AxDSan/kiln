// A shared library: no entry point. Every `public static` method of a
// `public static class` is exported under its own name, and `__MODULE___init`
// sets the static fields when the host is ready. The build writes
// `__MODULE__.h` beside the library — consumer.cpp includes it.
//
//   kiln build main.kiln --target sharedlib -o lib__MODULE__.so

namespace __MODULE__;

public static class Library
{
    static int greetings = 0;

    public static void Greet()
    {
        Console.WriteLine("Hello from a shared library.");
    }

    public static int Add(int a, int b) => a + b;

    public static string Greeting(string name)
    {
        greetings += 1;
        return $"Hello, {name}!";
    }

    public static int GreetingsSoFar() => greetings;
}
