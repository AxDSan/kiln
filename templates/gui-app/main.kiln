// A windowed program. The form is built, then `Main` runs if the form has one,
// then the event loop starts.
//
// The first `partial form` block is the designer's: Studio reads and writes it.
// The second is yours.

namespace __MODULE__;

using Kiln.Ui;

public partial form MainWindow
{
    Title = "__TITLE__";
    Width = 480;
    Height = 300;
    Icon = "app.png";

    Label greeting
    {
        Text = "Click the button.";
        Left = 40;
        Top = 50;
        Width = 200;
    }

    Button okButton
    {
        Text = "Click me";
        Left = 40;
        Top = 110;
        Width = 160;
        Height = 32;
        Click += OnOkClick;
    }
}

public partial form MainWindow
{
    void OnOkClick()
    {
        greeting.Text = "Button clicked.";
    }
}
