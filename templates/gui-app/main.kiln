# A windowed program. The form is the entry: it is built, then `main` runs
# (if present), then the event loop starts.
module __MODULE__
target gui
use ui

form main_window
  title = "__TITLE__"
  width = 480
  height = 300
  icon = "app.png"

  label greeting
    text = "Click the button."
    left = 40
    top = 50
    width = 200
    height = 24
  end

  button ok_button
    text = "Click me"
    left = 40
    top = 110
    width = 160
    height = 32
    on click: on_ok_click
  end
end

# Bound by function pointer — the handler's name never appears as data.
sub on_ok_click
  greeting.text = "Button clicked."
end
