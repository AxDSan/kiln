// Dates and clocks: the `time` support library.
//
// `using Kiln.Time;` brings in the Time* commands. Every one works in UTC and
// speaks Unix seconds as int64 — the same basis core's Now() uses, so the two
// compose.
//
//   kiln build examples/timelib.kiln -o timelib

namespace Timelib;

using Kiln.Time;

public static class Timelib
{
    public static void Main()
    {
        // --- a known moment: the first Apollo 11 moonwalk, 1969-07-21T02:56:15Z ---
        let apollo = TimeFromParts(1969, 7, 21, 2, 56, 15);
        PrintInt64(apollo);
        Console.WriteLine(TimeFormatIso(apollo));
        Console.WriteLine(TimeMonth(apollo));
        Console.WriteLine(TimeDay(apollo));
        Console.WriteLine(TimeHour(apollo));
        Console.WriteLine(TimeMinute(apollo));
        Console.WriteLine(TimeSecond(apollo));
        Console.WriteLine(TimeDayOfYear(apollo));
        // The epoch itself. 1970-01-01 was a Thursday: weekday is ISO, Mon=1..Sun=7.
        let epoch = IntToInt64(0);
        Console.WriteLine(TimeFormatIso(epoch));
        Console.WriteLine(TimeWeekday(epoch));
        // --- round trip: format then parse gives the same instant back ---
        if (TimeParseIso(TimeFormatIso(apollo)) == apollo)
        {
            Console.WriteLine("iso round trip ok");
        }
        // --- moving in time ---
        let dayLater = TimeAddSeconds(apollo, IntToInt64(86400));
        Console.WriteLine(TimeFormatIso(dayLater));
        PrintInt64(TimeDiffSeconds(dayLater, apollo));
        // --- the calendar ---
        if (TimeIsLeapYear(2024) && TimeIsLeapYear(2000))
        {
            Console.WriteLine("2024 and 2000 are leap years");
        }
        if (TimeIsLeapYear(1900))
        {
            Console.WriteLine("wrong: 1900 is not a leap year");
        }
        else
        {
            Console.WriteLine("1900 is not a leap year");
        }
        Console.WriteLine(TimeDaysInMonth(2024, 2));
        Console.WriteLine(TimeDaysInMonth(2023, 2));
        // --- failure reporting -------------------------------------------------
        // A bad string returns -1 AND writes the error slot. That matters because
        // -1 is itself a real timestamp (1969-12-31T23:59:59Z), so the returned
        // value alone cannot be trusted: LastErrorCode() is what distinguishes them.
        let bad = TimeParseIso("21 July 1969");
        PrintInt64(bad);
        if (LastErrorCode() != 0)
        {
            Console.WriteLine($"rejected: {LastErrorText()}");
        }
        // 30 February does not exist.
        PrintInt64(TimeFromParts(2023, 2, 30, 0, 0, 0));
        Console.WriteLine(LastErrorCode());
        // Success clears the slot again, so the next check is not fooled by the old
        // failure — and -1 here is a genuine timestamp, not an error.
        let lastSec = TimeParseIso("1969-12-31T23:59:59Z");
        PrintInt64(lastSec);
        Console.WriteLine(LastErrorCode());
        // --- clocks ------------------------------------------------------------
        // The wall clock agrees with core's Now(): the same instant, finer grained.
        let secs = TimeNowMs() / IntToInt64(1000);
        let drift = TimeDiffSeconds(secs, Now());
        if (IntToInt64(-1) <= drift && drift <= IntToInt64(0))
        {
            Console.WriteLine("now_ms agrees with now()");
        }
        // The monotonic clock has an arbitrary origin: only differences mean
        // anything. It never runs backwards. The empty loop just spends some time.
        let t0 = TimeMonotonicMs();
        foreach (var spin in 1..200000)
        {
        }
        if (TimeDiffSeconds(TimeMonotonicMs(), t0) >= IntToInt64(0))
        {
            Console.WriteLine("monotonic clock does not run backwards");
        }
    }
}
