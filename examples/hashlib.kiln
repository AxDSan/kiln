// The `hash` support library: digests and encodings — SHA-256, SHA-1, MD5,
// CRC32, HMAC-SHA-256, Base64 and hex.
//
//   kiln build examples/hashlib.kiln -o hashlib
//
// This program is the library's permanent proof of correctness. Every digest
// below is a published test vector, and a hash that is subtly wrong looks
// exactly like a hash that is right — so the check lives here, where anyone can
// run it, rather than in a comment.
//
// These are digests and encodings, NOT encryption. Base64 hides nothing, and a
// bare digest is not a way to store a password.
//
// `using Kiln.Hash;` brings in the Hash commands. The digests answer a lowercase
// hex string, so a check is a plain `==` against the published value.

namespace Hashlib;

using Kiln.Hash;

public static class Hashlib
{
    // Every published vector is checked through here: the label carries the story,
    // the boolean carries the verdict.
    public static void Vector(string label, bool ok)
    {
        if (ok)
        {
            Console.WriteLine($"ok   {label}");
        }
        else
        {
            Console.WriteLine($"FAIL {label}");
        }
    }

    public static void Main()
    {
        Console.WriteLine("-- SHA-256 (FIPS 180-4) --");
        Vector("sha256 of the empty string", HashSha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
        Vector("sha256 of \"abc\"", HashSha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
        // 56 bytes: one byte too long for the length to fit in the first block, so
        // this is the case that catches a broken padding loop.
        Vector("sha256 across two blocks", HashSha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
        Console.WriteLine("-- SHA-1 (FIPS 180-4) --");
        Vector("sha1 of the empty string", HashSha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709");
        Vector("sha1 of \"abc\"", HashSha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d");
        Vector("sha1 across two blocks", HashSha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "84983e441c3bd26ebaae4aa1f95129e5e54670f1");
        Console.WriteLine("-- MD5 (RFC 1321) --");
        Vector("md5 of the empty string", HashMd5("") == "d41d8cd98f00b204e9800998ecf8427e");
        Vector("md5 of \"abc\"", HashMd5("abc") == "900150983cd24fb0d6963f7d28e17f72");
        // MD5 is little-endian where SHA is big-endian: this catches the swap.
        Vector("md5 of the pangram", HashMd5("The quick brown fox jumps over the lazy dog") == "9e107d9d372bb6826bd81d3542a419d6");
        Console.WriteLine("-- CRC32 (zip / PNG) --");
        // Returned as int64, so a checksum with the top bit set is a value and not a
        // negative number.
        Vector("crc32 of \"123456789\" is 0xCBF43926", Int64ToText(HashCrc32("123456789")) == "3421780262");
        PrintInt64(HashCrc32("The quick brown fox jumps over the lazy dog"));
        Console.WriteLine("-- HMAC-SHA-256 (RFC 4231) --");
        // Case 1's key is twenty 0x0b bytes, which no text literal can spell — so it
        // is built with HexDecode, which is also a check of HexDecode itself.
        Vector("hmac rfc 4231 case 1", HashHmacSha256(HexDecode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), "Hi There") == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
        Vector("hmac rfc 4231 case 2", HashHmacSha256("Jefe", "what do ya want for nothing?") == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
        // Case 6: a 131-byte key, longer than the 64-byte block, so it must be hashed
        // before use. A version that truncates instead still passes cases 1 and 2.
        // Repeat("aa", 131) spells the key as 262 hex digits.
        let bigkey = HexDecode(Repeat("aa", 131));
        Vector("hmac rfc 4231 case 6 (oversized key)", HashHmacSha256(bigkey, "Test Using Larger Than Block-Size Key - Hash Key First") == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
        Console.WriteLine("-- Base64 (RFC 4648) --");
        // The RFC's own progression, which covers all three padding cases. `foreach`
        // walks a list literal one element at a time.
        foreach (var word in ["f", "fo", "foo", "foob", "fooba", "foobar"])
        {
            Console.WriteLine(Base64Encode(word));
        }
        Vector("base64 round trip", Base64Decode("Zm9vYmFy") == "foobar");
        Vector("base64 round trip of UTF-8", Base64Decode(Base64Encode("Kiln, 易语言")) == "Kiln, 易语言");
        Console.WriteLine("-- hex --");
        Console.WriteLine(HexEncode("hello"));
        Vector("hex decode ignores spaces and accepts capitals", HexDecode("68 65 6C 6C 6F") == "hello");
        Console.WriteLine("-- failure reporting --");
        // The two decoders are the only fallible commands here. Bad input gives ""
        // AND a non-zero LastErrorCode(), with the reason in LastErrorText(); good
        // input clears the error slot again.
        let bad = Base64Decode("!!! not base64 !!!");
        if (bad == "" && LastErrorCode() != 0)
        {
            Console.WriteLine($"ok   base64_decode reported: {LastErrorText()}");
        }
        else
        {
            Console.WriteLine("FAIL base64_decode did not report the bad input");
        }
        let odd = HexDecode("abc");
        if (odd == "" && LastErrorCode() != 0)
        {
            Console.WriteLine($"ok   hex_decode reported: {LastErrorText()}");
        }
        else
        {
            Console.WriteLine("FAIL hex_decode did not report the odd digit count");
        }
        let good = HexDecode("6f6b");
        Vector("a success clears the error slot", good == "ok" && LastErrorCode() == 0);
    }
}
