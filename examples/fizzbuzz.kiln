// Control flow: `match`, `for` over a range, comparisons and logical operators.

namespace Fizzbuzz;

public static class Fizzbuzz
{
    public static void Main()
    {
        // One value tested against several: `match` is the if-chain, written the way
        // it reads. `n % 15` is 0 only on a multiple of both 3 and 5.
        foreach (var n in 1..20)
        {
            if (n % 15 == 0)
            {
                Console.WriteLine("FizzBuzz");
            }
            else if (n % 15 == 3 || n % 15 == 6 || n % 15 == 9 || n % 15 == 12)
            {
                Console.WriteLine("Fizz");
            }
            else if (n % 15 == 5 || n % 15 == 10)
            {
                Console.WriteLine("Buzz");
            }
            else
            {
                Console.WriteLine(n);
            }
        }
        // Short-circuit `and`: the right side is not evaluated when n is 0, so the
        // division is safe.
        let zero = 0;
        if (zero != 0 && 100 % zero == 0)
        {
            Console.WriteLine("unreachable");
        }
        else
        {
            Console.WriteLine("short-circuit ok");
        }
        // Text equality compares content, not pointers; `+` joins, the same as concat.
        if ("fizz" + "buzz" == "fizzbuzz")
        {
            Console.WriteLine("text equality ok");
        }
    }
}
