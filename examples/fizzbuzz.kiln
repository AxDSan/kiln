// Control flow: `if`/`else if`, `foreach` over a range, comparisons and logical operators.
//
//   kiln build examples/fizzbuzz.kiln -o fizzbuzz
//   ./fizzbuzz

namespace Fizzbuzz;

public static class Fizzbuzz
{
    public static void Main()
    {
        // `1..20` is inclusive at both ends. One value tested against several is
        // an `else if` chain, with `||` for "any of these". `n % 15` is 0 only on
        // a multiple of both 3 and 5; it is worked out once, in `rest`.
        foreach (var n in 1..20)
        {
            let rest = n % 15;
            if (rest == 0)
            {
                Console.WriteLine("FizzBuzz");
            }
            else if (rest == 3 || rest == 6 || rest == 9 || rest == 12)
            {
                Console.WriteLine("Fizz");
            }
            else if (rest == 5 || rest == 10)
            {
                Console.WriteLine("Buzz");
            }
            else
            {
                Console.WriteLine(n);
            }
        }

        // Short-circuit `&&`: the right side is not evaluated when `zero` is 0,
        // so the division is safe.
        let zero = 0;
        if (zero != 0 && 100 % zero == 0)
        {
            Console.WriteLine("unreachable");
        }
        else
        {
            Console.WriteLine("short-circuit ok");
        }

        // `==` on strings compares content, not references; `+` joins two strings.
        if ("fizz" + "buzz" == "fizzbuzz")
        {
            Console.WriteLine("text equality ok");
        }
    }
}
