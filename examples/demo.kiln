// A tour of the core commands: text, numbers, maths and dates, and calls used
// as expressions — many of them written left-to-right with the method dot.
//
//   kiln run examples/demo.kiln

namespace Demo;

public static class Demo
{
    public static void Main()
    {
        // --- text ---
        // `x.f(a)` is `f(x, a)`, so a chain reads in the order it happens.
        let greeting = "Hello, " + "Kiln";
        Console.WriteLine(Uppercase(greeting));
        Console.WriteLine(Length(greeting));
        Console.WriteLine(Replace("a-b-c-d", "-", "/"));
        Console.WriteLine(Trim("   padded   "));
        Console.WriteLine(Reverse("stressed"));
        // --- integer math ---
        Console.WriteLine(MaxInt(3, 9));
        Console.WriteLine(PowInt(2, 10));
        Console.WriteLine(17 % 5);
        // --- floating point (no implicit conversion: convert explicitly) ---
        double two = IntToDouble(2);
        let root = Sqrt(two);
        Console.WriteLine(root);
        Console.WriteLine(Round(Pow(root, 2.0)));
        // --- conversions round-trip ---
        let n = TextToInt("42");
        Console.WriteLine($"n = {n}");
        // --- datetime (year of the epoch, UTC) ---
        Console.WriteLine(Year(IntToInt64(0)));
    }
}
