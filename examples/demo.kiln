// A tour of the core commands: text, numbers, maths and dates, and calls used
// as expressions — many of them written left-to-right with the method dot.
//
//   kiln build examples/demo.kiln -o demo

namespace Demo;

public static class Demo
{
    public static void Main()
    {
        // --- text ---
        // `x.F(a)` is `F(x, a)`, so a call reads in the order it happens.
        let greeting = "Hello, " + "Kiln";
        Console.WriteLine(greeting.Uppercase());            // HELLO, KILN
        Console.WriteLine(greeting.Length());               // 11
        Console.WriteLine("a-b-c-d".Replace("-", "/"));     // a/b/c/d
        Console.WriteLine("   padded   ".Trim());           // padded
        Console.WriteLine("stressed".Reverse());            // desserts
        // --- integer math ---
        Console.WriteLine(MaxInt(3, 9));                    // 9
        Console.WriteLine(PowInt(2, 10));                   // 1024
        Console.WriteLine(17 % 5);                          // 2
        // --- floating point (no implicit conversion: convert explicitly) ---
        double two = IntToDouble(2);
        let root = Sqrt(two);
        Console.WriteLine(root);
        Console.WriteLine(Round(Pow(root, 2.0)));
        // --- conversions round-trip ---
        let n = TextToInt("42");
        Console.WriteLine($"n = {n}");
        // --- datetime (the year of timestamp 0, the Unix epoch, in UTC) ---
        Console.WriteLine(Year(IntToInt64(0)));             // 1970
    }
}
