// A web service in twenty lines, with no socket anywhere in sight.
//
//   kiln build examples/webserver.kiln -o webserver
//   ./webserver
//   curl localhost:8080/hello?name=Ada
//   curl localhost:8080/quit
//
// The server is a component: it has properties and an event, exactly as a
// Button does, and what it lacks is a rectangle — so it is declared outside any
// class, and `Request += OnRequest;` wires its event to a static method. `Main`
// prints one line and returns — the program stays alive because the server is a
// live event source, the same way examples/loopdemo.kiln stays alive on a timer.
//
// It listens on 127.0.0.1 because that is the default and this program never
// says otherwise. Setting `Bind = "0.0.0.0";` would put it on every interface of
// the machine, which is a decision, not a default.

namespace Webserver;

using Kiln.Net;

Httpserver site
{
    Port = 8080;
    Request += OnRequest;
}

public static class Webserver
{
    // The event handler takes no parameters — the server calls it with none.
    // `NetRequest()` answers the request being dispatched right now, and passing
    // it on is what makes the real work a method with a parameter: a request
    // parked in a static field would serve the first caller and quietly hand the
    // second caller the first one's data.
    public static void OnRequest()
    {
        Route(NetRequest());
    }

    // One value tested against several routes, first match wins: an `if` /
    // `else if` chain, with a final `else` for every path nobody routed.
    public static void Route(int req)
    {
        let path = NetReqPath(req);
        if (path == "/")
        {
            ReplyHome(req);
        }
        else if (path == "/hello")
        {
            ReplyHello(req);
        }
        else if (path == "/echo")
        {
            NetReqReply(req, 200, NetReqBody(req));
        }
        else if (path == "/quit")
        {
            NetReqReply(req, 200, "stopping\n");
            Quit();
        }
        else
        {
            NetReqReply(req, 404, $"no route for {path}");
        }
    }

    public static void ReplyHome(int req)
    {
        let page = "<h1>Kiln</h1><p>Try <a href='/hello?name=Ada'>/hello?name=Ada</a>.</p>";
        NetReqReplyAs(req, 200, "text/html; charset=utf-8", page);
    }

    // `C ? A : B` chooses a value, and an interpolated string `$"...{hole}..."`
    // fills in the rest.
    public static void ReplyHello(int req)
    {
        let who = NetReqQuery(req, "name");
        let greeting = (who == "" ? "hello, world" : $"hello, {who} via {NetReqMethod(req)}");
        NetReqReply(req, 200, greeting);
    }

    public static void Main()
    {
        Console.WriteLine("serving on http://127.0.0.1:8080 — curl it, then GET /quit");
    }
}
