// Networking: TCP, HTTP, and what a program sees when a url needs TLS.
//
//   kiln run examples/netlib.kiln
//
// Only the https line needs the network, and only on a toolchain that vendored
// mbedTLS; everything else is pure or dials a closed port on purpose, because
// the failures a program must be able to detect are the point of the file.

namespace Netlib;

using Kiln.Net;

public static class Netlib
{
    public static void Main()
    {
        // --- percent-encoding round-trips ---
        let raw = "name=Ada Lovelace & co/100%";
        let enc = NetUrlEncode(raw);
        Console.WriteLine(enc);
        Console.WriteLine(NetUrlDecode(enc));
        if (NetUrlDecode(enc) == raw)
        {
            Console.WriteLine("round-trip ok");
        }
        // --- https either dials or refuses, and is never downgraded to http ---
        // Which branch runs is a fact about the build, not about this program: TLS is
        // an optional dependency, so a toolchain without mbedTLS vendored answers
        // 10006 here and one with it makes the connection for real.
        let body = NetHttpGet("https://example.com/");
        if (LastErrorCode() == 10006)
        {
            Console.WriteLine("https refused: this build has no TLS");
            Console.WriteLine(LastErrorText());
        }
        else
        {
            Console.WriteLine("https dialled over TLS");
        }
        // --- a scheme that is not http at all ---
        Console.WriteLine(NetHttpGet("ftp://example.com/x"));
        Console.WriteLine(LastErrorCode());
        // --- a connection that cannot succeed: nothing listens on this port ---
        Console.WriteLine(NetTimeoutGet());
        if (NetTimeoutSet(1500))
        {
            Console.WriteLine(NetTimeoutGet());
        }
        let h = NetTcpConnect("127.0.0.1", 9);
        if (h == 0)
        {
            Console.WriteLine("connect failed as expected");
            Console.WriteLine(LastErrorText());
        }
        else
        {
            Console.WriteLine("unexpectedly connected");
            if (NetTcpClose(h))
            {
                Console.WriteLine("closed");
            }
        }
        // --- a name that does not resolve ---
        Console.WriteLine(NetHostIp("no-such-host.invalid"));
        if (LastErrorCode() != 0)
        {
            Console.WriteLine("resolver failure reported");
        }
        // --- localhost always resolves, without touching the network ---
        Console.WriteLine(NetHostIp("127.0.0.1"));
        // --- the serving side, with nothing served ---
        // net_request() answers only inside an httpserver `request` handler; asking
        // for one anywhere else is a failure, not an empty answer, because a program
        // that got 0 back and carried on would be replying into nothing.
        Console.WriteLine(NetRequest());
        if (LastErrorCode() == 10005)
        {
            Console.WriteLine("no request outside a handler, as expected");
        }
        // And a handle that is not a request is refused rather than read.
        Console.WriteLine(NetReqPath(0));
        Console.WriteLine(LastErrorCode());
        // --- a stale handle is detected, not dereferenced ---
        Console.WriteLine(NetTcpCloseAll());
        if (NetTcpClose(1))
        {
            Console.WriteLine("BUG: closed a handle that was never open");
        }
        else
        {
            Console.WriteLine("stale handle refused");
            Console.WriteLine(LastErrorCode());
        }
    }
}
