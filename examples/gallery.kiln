// The visual palette: one window holding every control you can put on a form.
//
//   kiln build examples/gallery.kiln -o gallery
//
// `Items` is ONE string with a newline between entries. That is not shorthand
// for a `List<string>` — a property value in the designer's half is a literal,
// so a list has to arrive as one value — and it is what a method appends to as
// well:
//
//   colours.Items = colours.Items + "\nPurple";
//
// Positions count from 1, so `Selected = 2` is the second entry and 0 is
// "nothing chosen".

namespace Gallery;

using Kiln.Ui;

public partial form Win
{
    Title = "Kiln palette";
    Width = 640;
    Height = 520;
    BackgroundColor = "#f6f8fa";

    Label pickLabel
    {
        Text = "Pick a colour";
        Left = 24;
        Top = 20;
        Width = 200;
        Color = "#1f2328";
    }

    Combobox colours
    {
        Items = "Red\nGreen\nBlue\nAmber";
        Selected = 3;
        Left = 24;
        Top = 44;
        Width = 200;
        Height = 28;
        Change += OnColour;
    }

    Label listLabel
    {
        Text = "Or from a visible list";
        Left = 24;
        Top = 92;
        Width = 220;
        Color = "#1f2328";
    }

    Listbox cities
    {
        Items = "Amsterdam\nBerlin\nCairo\nDakar\nEdinburgh";
        Selected = 2;
        Left = 24;
        Top = 116;
        Width = 200;
        Height = 140;
        Change += OnCity;
    }

    Groupbox sizeGroup
    {
        Text = "Size";
        Left = 260;
        Top = 20;
        Width = 180;
        Height = 130;
    }

    Radiobutton sizeSmall
    {
        Text = "Small";
        Group = "size";
        Left = 276;
        Top = 52;
        Color = "#1f2328";
        Change += OnSize;
    }

    Radiobutton sizeMedium
    {
        Text = "Medium";
        Group = "size";
        Checked = true;
        Left = 276;
        Top = 82;
        Color = "#1f2328";
        Change += OnSize;
    }

    Radiobutton sizeLarge
    {
        Text = "Large";
        Group = "size";
        Left = 276;
        Top = 112;
        Color = "#1f2328";
        Change += OnSize;
    }

    Label notesLabel
    {
        Text = "Notes";
        Left = 260;
        Top = 164;
        Width = 200;
        Color = "#1f2328";
    }

    Memo notes
    {
        Text = "A memo holds more than one line.\nThis is the second.";
        Left = 260;
        Top = 188;
        Width = 340;
        Height = 92;
        Color = "#1f2328";
    }

    Label volumeLabel
    {
        Text = "Volume";
        Left = 24;
        Top = 268;
        Width = 200;
        Color = "#1f2328";
    }

    Slider volume
    {
        Min = 0;
        Max = 100;
        Value = 70;
        Left = 24;
        Top = 292;
        Width = 200;
        Height = 20;
        Change += OnVolume;
    }

    Label copiesLabel
    {
        Text = "Copies";
        Left = 260;
        Top = 296;
        Width = 120;
        Color = "#1f2328";
    }

    Spinner copies
    {
        Value = 3;
        Min = 1;
        Max = 99;
        Step = 1;
        Left = 340;
        Top = 292;
        Width = 110;
        Height = 28;
        Change += OnCopies;
    }

    Progressbar bar
    {
        Value = 70;
        Left = 24;
        Top = 340;
        Width = 426;
        Height = 16;
    }

    Button report
    {
        Text = "Report";
        Left = 24;
        Top = 380;
        Width = 140;
        Height = 40;
        BackgroundColor = "#1e60d5";
        Color = "#ffffff";
        BorderRadius = 6;
        Click += OnReport;
    }

    Label status
    {
        Text = "Nothing chosen yet.";
        Left = 184;
        Top = 392;
        Width = 420;
        Color = "#1f2328";
    }
}

public partial form Win
{
    void OnColour()
    {
        status.Text = $"colour #{colours.Selected}";
    }

    void OnCity()
    {
        status.Text = $"city #{cities.Selected}";
    }

    void OnSize()
    {
        status.Text = "size changed";
    }

    // The bar follows the slider, which is the shortest way to see that reading a
    // control gives back what the person did rather than what the form said.
    void OnVolume()
    {
        bar.Value = volume.Value;
        status.Text = $"volume {volume.Value}";
    }

    void OnCopies()
    {
        status.Text = $"copies {copies.Value}";
    }

    void OnReport()
    {
        Console.WriteLine($"colour  = {colours.Selected}");
        Console.WriteLine($"city    = {cities.Selected}");
        Console.WriteLine($"cities  = {cities.Count}");
        Console.WriteLine($"volume  = {volume.Value}");
        Console.WriteLine($"copies  = {copies.Value}");
        Console.WriteLine($"notes   = {notes.Text}");
    }
}
