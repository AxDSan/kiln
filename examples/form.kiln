// A window with a label and a button, and a handler wired to its click.
//
// The form is split into two halves of one `partial form`. The first block is
// the designer's half: the window's properties, then each control with its own
// properties and the events it wires with `+=`. Studio reads and rewrites that
// block, so you can open this file in Studio and drag things around. The second
// block is your half — fields and methods — and Studio never touches it, so the
// file stays yours.
//
//   kiln build examples/form.kiln -o form

namespace HelloForm;

using Kiln.Ui;

public partial form MainWindow
{
    Title = "Kiln";
    Width = 480;
    Height = 300;
    BackgroundColor = "#1e2233";

    Label greeting
    {
        Text = "Click the button.";
        Left = 40;
        Top = 40;
        Width = 400;
        Color = "#ffffff";
    }

    Button okButton
    {
        Text = "Click me";
        Left = 40;
        Top = 110;
        Width = 160;
        Height = 44;
        BackgroundColor = "#4a86e8";
        BorderRadius = 8;
        Click += OnOkClick;
    }
}

public partial form MainWindow
{
    // The click handler is an ordinary method of the form, named by
    // `Click += OnOkClick` above. It is bound directly, not looked up by name at
    // run time, so the name never reaches the shipped binary.
    void OnOkClick()
    {
        Console.WriteLine("button clicked!");
    }
}
