// Arithmetic and text operators.
//
//   kiln build examples/operators.kiln -o operators
//   ./operators
//
//   -x        negation, of a literal or of any numeric expression
//   a % b     remainder; its sign follows `a`, so -17 % 5 is -2
//   a + b     on two strings, joining them into a new string
//   $"…{x}…"  string interpolation: the same join, written as the text it makes
//
// For anything longer than one join, interpolation is the one to reach for:
// the finished sentence is visible in the source.

namespace Operators;

public static class Operators
{
    public static void Main()
    {
        // A negative literal is a literal: it may be as small as `int` goes.
        let freezing = -40;
        Console.WriteLine(freezing);
        Console.WriteLine(-freezing);

        // Negation applies to any numeric expression, not just literals, and to
        // `double` as well as `int`.
        var owed = 250;
        Console.WriteLine(-owed);
        let below = -1.5;
        Console.WriteLine(-below);

        // Remainder, and the classic thing it is for.
        Console.WriteLine(17 % 5);
        Console.WriteLine(-17 % 5);
        Console.WriteLine(Parity(6));
        Console.WriteLine(Parity(7));

        // Joining text. Read this line, then read the version underneath it.
        let who = "Ada";
        Console.WriteLine("Hello, " + who + " — you are " + IntToText(36) + " today.");
        Console.WriteLine($"Hello, {who} — you are {IntToText(36)} today.");
    }

    // Inside `$"…"`, `{n}` puts the number into the text.
    public static string Parity(int n)
    {
        if (n % 2 == 0)
        {
            return $"{n} is even";
        }
        return $"{n} is odd";
    }
}
