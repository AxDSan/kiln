// A chat client: a form, a `tcpclient`, and nothing that blocks.
//
//   kiln run examples/tcpecho.kiln 7000     (in one terminal)
//   kiln run examples/tcpchat.kiln          (in another)
//
// Connect is non-blocking: `Connect` asks, and the answer arrives later as
// `connect` or `error` while the window keeps painting. `receive` hands the
// handler each line the server sent, delimiter stripped, and `send` puts a
// line on the wire — the client speaks lines because `delimiter` is a
// newline, which is the default.

namespace Tcpchat;

using Kiln.Ui;
using Kiln.Net;

Tcpclient link
{
    Name = "link";
    Host = "127.0.0.1";
    Port = 7000;
    Connect += OnConnect;
    Disconnect += OnDisconnect;
    Receive += OnReceive;
    Error += OnError;
}

public partial form Win
{
    Title = "Chat";
    Width = 480;
    Height = 360;

    Memo log
    {
        Left = 12;
        Top = 12;
        Width = 456;
        Height = 250;
        Enabled = false;
    }

    Editbox entry
    {
        Left = 12;
        Top = 274;
        Width = 300;
    }

    Button send
    {
        Text = "Send";
        Left = 320;
        Top = 274;
        Width = 60;
        Click += OnSend;
    }

    Button connect
    {
        Text = "Connect";
        Left = 388;
        Top = 274;
        Width = 80;
        Click += OnToggle;
    }
}

public partial form Win
{
    void Say(string line)
    {
        log.Text = $"{log.Text}{line}\n";
    }

    void OnToggle()
    {
        if (link.Connected)
        {
            link.Active = false;
        }
        else
        {
            Say("connecting...");
            link.Active = true;
        }
    }

    void OnSend()
    {
        if (TcpclientSend("link", entry.Text + "\n"))
        {
            Say($"> {entry.Text}");
            entry.Text = "";
        }
        else
        {
            Say($"not sent: {LastErrorText()}");
        }
    }

    void OnConnect()
    {
        Say("connected");
        connect.Text = "Disconnect";
    }

    void OnDisconnect()
    {
        Say("disconnected");
        connect.Text = "Connect";
    }

    void OnReceive(string data)
    {
        Say($"< {data}");
    }

    void OnError(string message)
    {
        Say($"error: {message}");
        connect.Text = "Connect";
    }
}
