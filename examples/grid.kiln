// Rows in a grid, and a datasource that feeds it.
//
//   kiln run examples/grid.kiln
//
// The grid never holds the people itself: it is bound by name to a datasource,
// and shows whatever that holds. Fill the datasource once — in the form, from
// `main`, from a handler — and every grid bound to it shows the rows. That is
// the shape a `database` kit will hand its query results into.
//
// Rows are one text with a newline between rows and a tab between cells,
// because a property value is a literal. The commands are the way around
// building that text by hand: `datasource_add_row` takes a row, `grid_cell`
// reads one cell back, and both count from 1 like every position here.
//
// `select` and `activate` hand the handler the row. A handler may take it or
// leave it out.

namespace Grid;

using Kiln.Ui;

Datasource people
{
    Name = "people";
    Columns = "Name\tCity\tAge";
    Rows = "Ada\tLondon\t36\nLinus\tHelsinki\t28\nGrace\tArlington\t45";
}

public partial form Win
{
    Title = "Grid";
    Width = 520;
    Height = 330;
    BackgroundColor = "#f6f8fa";

    Label heading
    {
        Text = "People";
        Left = 20;
        Top = 16;
        Width = 200;
        Color = "#1f2328";
    }

    Grid table
    {
        Name = "table";
        Bind = "people";
        Selected = 2;
        Left = 20;
        Top = 44;
        Width = 480;
        Height = 150;
        Select += OnSelect;
        Activate += OnActivate;
    }

    Label status
    {
        Text = "Pick a row.";
        Left = 20;
        Top = 208;
        Width = 480;
        Color = "#1f2328";
    }

    Button add
    {
        Text = "Add a row";
        Left = 20;
        Top = 240;
        Width = 140;
        Height = 34;
        Color = "#ffffff";
        BorderRadius = 6;
        Click += OnAdd;
    }

    Button older
    {
        Text = "Age selected";
        Left = 176;
        Top = 240;
        Width = 140;
        Height = 34;
        BackgroundColor = "#6e7781";
        Color = "#ffffff";
        BorderRadius = 6;
        Click += OnOlder;
    }
}

public partial form Win
{
    // Rows added before the window opens are on screen from the first frame.
    void Main()
    {
        DatasourceAddRow("people", "Dennis\tNew York\t70");
        let rows = GridRowCount("table");
        Console.WriteLine($"rows: {rows}");
    }

    void OnSelect(int row)
    {
        status.Text = "Selected " + GridCell("table", row, 1);
        Console.WriteLine($"select {row}");
    }

    void OnActivate(int row)
    {
        status.Text = "Opened " + GridCell("table", row, 1);
        Console.WriteLine($"activate {row}");
    }

    void OnAdd()
    {
        var n = people.Count + 1;
        DatasourceAddRow("people", $"Person {n}\tNowhere\t0");
        table.Selected = n;
    }

    void OnOlder()
    {
        if (table.Selected > 0)
        {
            int age = TextToInt(GridCell("table", table.Selected, 3));
            GridSetCell("table", table.Selected, 3, IntToText(age + 1));
        }
    }
}
