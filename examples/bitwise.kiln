// Bitwise operators and hex/binary literals.
//
//   kiln build examples/bitwise.kiln -o bitwise
//
// A self-checking transcript: every line prints `ok` or `FAIL`, so running it
// is the test. It covers the two halves that arrived together — writing a
// constant as the bit pattern it is, and doing to bits what `+` does to
// numbers.

namespace Bitwise;

public static class Bitwise
{
    // A flag word written the way its documentation writes it. `0x8000_0000` has
    // the top bit of a 32-bit word set, so as an `int` it is the most negative
    // `int`; where a `long` is wanted it is 2147483648. Both readings are the
    // same 32 bits.
    public const int WsVisible = 0x1000_0000;
    public const int WsPopup = 0x8000_0000;
    public const int WsBorder = 0x0080_0000;

    public static void Check(string what, int got, int want)
    {
        if (got == want)
        {
            Console.WriteLine($"ok {what}");
        }
        else
        {
            Console.WriteLine($"FAIL {what}: got {got}, wanted {want}");
        }
    }

    public static void Check64(string what, long got, long want)
    {
        if (got == want)
        {
            Console.WriteLine($"ok {what}");
        }
        else
        {
            Console.WriteLine($"FAIL {what}: got {got}, wanted {want}");
        }
    }

    public static void Main()
    {
        // --- literals ------------------------------------------------------------
        // `0x` is hex, `0b` is binary, and `_` separates digits anywhere without
        // changing the value.
        Check("hex", 0xFF, 255);
        Check("hex lower", 0xff, 255);
        Check("binary", 0b1010, 10);
        Check("underscores", 0b1111_1111, 255);
        // A 32-bit pattern is an `int` holding exactly those bits.
        Check("sign bit", 0x80000000, -2147483648);
        Check("all ones", 0xFFFF_FFFF, -1);
        Check("deadbeef", 0xDEAD_BEEF, -559038737);
        // ...and the same pattern is 2147483648 where a `long` is wanted.
        long wide = 0x8000_0000;
        Check64("sign bit widens with zeros", wide, 2147483648);
        // A pattern that needs more than 32 bits is a `long` on its own.
        long big = 0x1_0000_0000;
        Check64("wide literal", big, 4294967296);
        long ones = 0xFFFF_FFFF_FFFF_FFFF;
        Check64("64 ones", ones, -1);
        // A leading `-` says the pattern was meant as a magnitude.
        Check("negated hex", -0x10, -16);
        // --- the operators -------------------------------------------------------
        // `&` is and, `|` is or, `^` is exclusive or, `~` flips every bit, and
        // `<<` / `>>` shift.
        Check("band", 0xF0 & 0x0F, 0);
        Check("band keeps", 0xF3 & 0x0F, 3);
        Check("bor", 0xF0 | 0x0F, 255);
        Check("bxor", 5 ^ 1, 4);
        Check("bnot", ~0, -1);
        Check("bnot again", ~5, -6);
        Check("shl", 1 << 4, 16);
        Check("shr", 256 >> 4, 16);
        // `>>` on an `int` keeps the sign; `>>>` shifts zeros in.
        Check("shr is arithmetic", -16 >> 2, -4);
        Check("ushr is logical", -16 >>> 2, 1073741820);
        int n = 3;
        Check("a computed count", 1 << n, 8);
        // --- precedence ----------------------------------------------------------
        // The table is C#'s: a comparison binds TIGHTER than `&`, so a flag test
        // needs its parentheses. Leaving them out is not a silent bug — `x & F != 0`
        // asks `if` to test a number, and that is a compile error.
        int style = WsVisible | WsPopup;
        if ((style & WsVisible) != 0)
        {
            Console.WriteLine("ok flag is set");
        }
        else
        {
            Console.WriteLine("FAIL flag is set");
        }
        if ((style & WsBorder) == 0)
        {
            Console.WriteLine("ok flag is clear");
        }
        else
        {
            Console.WriteLine("FAIL flag is clear");
        }
        // Shifts bind tighter than `&`, `+` tighter than a shift, and `&` tighter
        // than `|`.
        Check("shl before band", 1 << 4 & 0xFF, 16);
        Check("plus before shl", 1 << 2 + 2, 16);
        Check("band before bor", 1 | 6 & 4, 5);
        // --- what this was for ---------------------------------------------------
        // LOWORD / HIWORD of a WPARAM, which is a `long`. The mask is an `int`
        // literal, and a literal takes the width of what it meets.
        long wparam = 196610;
        Check64("LOWORD", wparam & 0xFFFF, 2);
        Check64("HIWORD", wparam >>> 16 & 0xFFFF, 3);
        // Flags combined, then one taken away: `& ~flag` keeps every bit but that one.
        int flags = WsVisible | WsPopup | WsBorder;
        Check("flag cleared", flags & ~WsBorder, WsVisible | WsPopup);
    }
}
