// Bitwise operators and hex/binary literals.
//
// A self-checking transcript: every line prints `ok` or `FAIL`, so running it
// is the test. It covers the two halves that arrived together — writing a
// constant as the bit pattern it is, and doing to bits what `+` does to
// numbers.

namespace Bitwise;

public static class Bitwise
{
    public const int WsVisible = 268435456;
    public const int WsPopup = 2147483648;
    public const int WsBorder = 8388608;

    public static void Check(string what, int got, int want)
    {
        if (got == want)
        {
            Console.WriteLine($"ok {what}");
        }
        else
        {
            Console.WriteLine($"FAIL {what}: got {got}, wanted {want}");
        }
    }

    public static void Check64(string what, long got, long want)
    {
        if (got == want)
        {
            Console.WriteLine($"ok {what}");
        }
        else
        {
            Console.WriteLine($"FAIL {what}: got {got}, wanted {want}");
        }
    }

    public static void Main()
    {
        // --- literals ------------------------------------------------------------
        Check("hex", 255, 255);
        Check("hex lower", 255, 255);
        Check("binary", 10, 10);
        Check("underscores", 255, 255);
        // A 32-bit pattern is an `int` holding exactly those bits.
        Check("sign bit", 2147483648, -2147483648);
        Check("all ones", 4294967295, -1);
        Check("deadbeef", 3735928559, -559038737);
        // ...and the same pattern is 2147483648 where an int64 is wanted.
        long wide = 2147483648;
        Check64("sign bit widens with zeros", wide, 2147483648);
        // A pattern that needs more than 32 bits is an int64 on its own.
        long big = 4294967296;
        Check64("wide literal", big, 4294967296);
        long ones = 18446744073709551615;
        Check64("64 ones", ones, -1);
        // A leading `-` says the pattern was meant as a magnitude.
        Check("negated hex", -16, -16);
        // --- the operators -------------------------------------------------------
        Check("band", 240 & 15, 0);
        Check("band keeps", 243 & 15, 3);
        Check("bor", 240 | 15, 255);
        Check("bxor", 5 ^ 1, 4);
        Check("bnot", ~0, -1);
        Check("bnot again", ~5, -6);
        Check("shl", 1 << 4, 16);
        Check("shr", 256 >> 4, 16);
        // `shr` keeps the sign; `ushr` shifts zeros in.
        Check("shr is arithmetic", -16 >> 2, -4);
        Check("ushr is logical", -16 >>> 2, 1073741820);
        int n = 3;
        Check("a computed count", 1 << n, 8);
        // --- precedence ----------------------------------------------------------
        // A bitwise operator binds LOOSER than a comparison, so a flag test needs no
        // parentheses. (This is the one place C's table is famously the wrong way
        // round.)
        int style = WsVisible | WsPopup;
        if ((style & WsVisible) != 0)
        {
            Console.WriteLine("ok flag is set");
        }
        else
        {
            Console.WriteLine("FAIL flag is set");
        }
        if ((style & WsBorder) == 0)
        {
            Console.WriteLine("ok flag is clear");
        }
        else
        {
            Console.WriteLine("FAIL flag is clear");
        }
        // Shifts bind tighter than `band`, and `+` tighter than a shift.
        Check("shl before band", 1 << 4 & 255, 16);
        Check("plus before shl", 1 << 2 + 2, 16);
        Check("band before bor", 1 | 6 & 4, 5);
        // --- what this was for ---------------------------------------------------
        // LOWORD / HIWORD of a WPARAM, which is an int64. The mask is an int
        // literal, and a literal takes the width of what it meets.
        long wparam = 196610;
        Check64("LOWORD", wparam & 65535, 2);
        Check64("HIWORD", wparam >>> 16 & 65535, 3);
        // Flags combined, then one taken away.
        int flags = WsVisible | WsPopup | WsBorder;
        Check("flag cleared", flags & ~WsBorder, WsVisible | WsPopup);
    }
}
