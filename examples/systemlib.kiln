// The `system` library: the environment the program runs in.
//
//   kiln run examples/systemlib.kiln

namespace Systemlib;

using Kiln.System;

public static class Systemlib
{
    public static void Main()
    {
        // --- the machine ---
        Console.WriteLine($"os: {OsName()}");
        Console.WriteLine($"arch: {OsArch()}");
        // A host name and a home directory always exist on a working machine, so
        // print whether the query succeeded rather than the values themselves —
        // the output has to be the same on every machine to be checkable.
        let host = OsHostName();
        if (LastErrorCode() == 0 && Length(host) > 0)
        {
            Console.WriteLine("host name: ok");
        }
        else
        {
            Console.WriteLine($"host name failed: {LastErrorText()}");
        }
        let home = OsHomeDir();
        if (LastErrorCode() == 0 && Length(home) > 0)
        {
            Console.WriteLine("home dir: ok");
        }
        // --- the environment block ---
        if (EnvSet("KILN_DEMO", "hello"))
        {
            Console.WriteLine("KILN_DEMO = " + EnvGet("KILN_DEMO"));
        }
        // A variable set to nothing and a variable that is absent both read as "".
        // env_has is what tells them apart.
        if (EnvSet("KILN_EMPTY", ""))
        {
            Console.WriteLine("set to empty");
        }
        if (EnvHas("KILN_EMPTY") && TextEq(EnvGet("KILN_EMPTY"), ""))
        {
            Console.WriteLine("empty but present");
        }
        if (EnvUnset("KILN_EMPTY"))
        {
            if (EnvHas("KILN_EMPTY"))
            {
                Console.WriteLine("still there?");
            }
            else
            {
                Console.WriteLine("absent after unset");
            }
        }
        // An unset variable is a "no", not a failure: the error slot stays clear.
        let missing = EnvGet("KILN_NOT_SET_ANYWHERE");
        Console.WriteLine(LastErrorCode());
        Console.WriteLine(Length(missing));
        // A name that cannot address a variable at all IS a failure.
        let bad = EnvGet("");
        if (LastErrorCode() != 0)
        {
            Console.WriteLine($"rejected: {LastErrorText()}");
        }
        // The block is a count plus an indexed accessor; PATH is in it.
        if (EnvCount() > 0)
        {
            let first = EnvNameAt(1);
            if (LastErrorCode() == 0 && Length(first) > 0 && EnvHas(first))
            {
                Console.WriteLine("environment is not empty");
            }
        }
        let pastBlock = EnvNameAt(EnvCount() + 1);
        if (LastErrorCode() != 0)
        {
            Console.WriteLine("env index out of range rejected");
        }
        if (SysProcessId() > 0)
        {
            // --- this process ---
            Console.WriteLine("pid: ok");
        }
        if (SysArgCount() == 0)
        {
            // sys_arg(1) is the first REAL argument — the program name is not one of
            // them, and lives in sys_program_path().  So a program run with no arguments
            // reports 0, which is what anyone would guess.
            Console.WriteLine("no arguments: ok");
        }
        let pastEnd = SysArg(9999);
        if (LastErrorCode() != 0)
        {
            Console.WriteLine("out of range rejected");
        }
        if (Length(SysProgramDir()) > 0 && LastErrorCode() == 0)
        {
            Console.WriteLine("program dir: ok");
        }
        // --- timing ---
        let t0 = SysTickCount();
        SysSleepMs(60);
        let t1 = SysTickCount();
        let waited = Int64ToInt(t1 - t0);
        if (50 <= waited && waited < 2000)
        {
            Console.WriteLine("slept about 60ms");
        }
        else
        {
            Console.WriteLine($"suspicious wait: {waited}");
        }
        Console.WriteLine("done");
        SysQuit(0);
        Console.WriteLine("unreachable");
    }
}
