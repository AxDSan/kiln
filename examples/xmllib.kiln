// Reading the tables XML data files carry.
//
// The client ships XML that declares GB2312 over bytes that are really GBK, a
// comment block full of Chinese, CRLF, and one self-closing row per item. This
// program writes a table of that shape — as BYTES, because that is the whole
// point — and then reads it the way a server reads the real thing.
//
//   kiln run examples/xmllib.kiln

namespace Xmllib;

using Kiln.File;
using Kiln.Xml;
using Kiln.Text;
using Kiln.Encoding;

public static class Xmllib
{
    public static void Main()
    {
        let path = "/tmp/kiln_xmllib.xml";
        // --- a table in the shape these files have ---------------------------
        // Built byte by byte: the declaration lies about the encoding on purpose, and
        // 214/208 is 中 in GBK, which Rust-style source text cannot express.
        Bytes doc = BytesNew(0);
        doc = BytesConcat(doc, BytesFromText("<?xml version=\"1.0\" encoding=\"GB2312\"?>\n"));
        doc = BytesConcat(doc, BytesFromText("<!--\"weapon\", "));
        Bytes cn = BytesNew(2);
        BytesSet(cn, 1, 206);
        BytesSet(cn, 2, 228);
        doc = BytesConcat(doc, cn);
        doc = BytesConcat(doc, BytesFromText(" -->\n"));
        doc = BytesConcat(doc, BytesFromText("<ItemBaseAttribute>\n  <Weapons>\n    <Swords>\n"));
        doc = BytesConcat(doc, BytesFromText("      <ShortSword ID=\"1000\" Attack=\"15,23,39,68,118\" Icon=\"36,144\"/>\n"));
        doc = BytesConcat(doc, BytesFromText("      <Scimitar ID=\"1001\" Attack=\"65,78,102,141,208\"/>\n"));
        doc = BytesConcat(doc, BytesFromText("    </Swords>\n  </Weapons>\n"));
        doc = BytesConcat(doc, BytesFromText("  <Armors>\n    <Plate ID=\"2100\" Attack=\"9\"/>\n  </Armors>\n"));
        doc = BytesConcat(doc, BytesFromText("</ItemBaseAttribute>\n"));
        FileWriteBytes(path, doc);
        // --- reading it back --------------------------------------------------
        let h = XmlParse(FileReadBytes(path));
        if (h == 0)
        {
            Console.WriteLine($"parse failed: {LastErrorText()}");
            return;
        }
        let root = XmlRoot(h);
        let rname = XmlName(h, root);
        let nchild = XmlCount(h, root);
        Console.WriteLine($"{rname}: {nchild} groups, starting on line {XmlLine(h, root)}");
        // By position, which is how a program walks groups it cannot name in advance.
        foreach (var i in 1..nchild)
        {
            let group = XmlChild(h, root, i);
            let gname = XmlName(h, group);
            let rows = XmlCount(h, group);
            Console.WriteLine($"  group {i}: {gname} ({rows} child)");
        }
        // By name, descending: the item rows sit two levels below the root.
        let sword = XmlDescend(h, root, "ShortSword");
        let sname = XmlName(h, sword);
        let sid = XmlAttr(h, sword, "ID");
        let satk = XmlAttr(h, sword, "Attack");
        Console.WriteLine($"found {sname} ID={sid} Attack={satk}");
        // Every row of the Swords group, whatever its element is called — which is
        // the case here, since the client names each row its own template.
        let swords = XmlFirst(h, XmlChild(h, root, 1), "Swords");
        var row = XmlFirst(h, swords, "");
        var total = 0;
        while (row != 0)
        {
            let nm = XmlName(h, row);
            let atk = XmlAttr(h, row, "Attack");
            Console.WriteLine($"  {nm}: {atk}");
            int first = 0;
            if (TextSplitCount(atk, ",") > 0)
            {
                first = TextToInt(TextSplitAt(atk, ",", 1));
            }
            total = total + first;
            row = XmlSibling(h, row, "");
        }
        Console.WriteLine($"total first-tick attack: {total}");
        // An attribute that is not there answers "" without failing, and the
        // predicate is what tells "absent" from "empty".
        let missing = XmlAttr(h, sword, "MaterialProyAdd");
        let has = XmlHasAttr(h, sword, "MaterialProyAdd");
        Console.WriteLine($"MaterialProyAdd '{missing}' present={has} error code {LastErrorCode()}");
        // --- the GBK the comment block carries --------------------------------
        // Only visible after decoding: the parser hands back the file's bytes
        // untouched, which is what makes a document whose declaration lies readable.
        let text = EncodingDecode(FileReadBytes(path), "gbk");
        let ok = TextContains(text, "武");
        Console.WriteLine($"decoded to UTF-8, comment reads back: {ok}");
        Console.WriteLine(XmlCloseAll());
    }
}
