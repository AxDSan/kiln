// Settings files — the `config` support library.
//
//   kiln build examples/configlib.kiln -o configlib
//
// INI is the format a person can open in a text editor and understand without
// being taught anything first: a [section], then `key = value` lines, and `#`
// for a comment. This program writes one, reads it back, and walks it.
//
// The scratch file lives in /tmp, so running this leaves the repository clean.
//
// `using Kiln.Config;` brings in the Config commands. A settings file is a
// handle — a plain int, 0 when it could not be had — and a command that fails
// says why through LastErrorCode() and LastErrorText().

namespace Configlib;

using Kiln.Config;

public static class Configlib
{
    public static void Main()
    {
        let path = "/tmp/kiln-configlib.ini";
        // --- write a settings file --------------------------------------------
        // ConfigCreate remembers the path; nothing touches the disk until ConfigSave.
        var h = ConfigCreate(path);
        if (h == 0)
        {
            Console.WriteLine($"cannot create: {LastErrorText()}");
        }
        else
        {
            if (ConfigSet(h, "window", "title", "Kiln"))
            {
                Console.WriteLine("set window.title");
            }
            if (ConfigSetInt(h, "window", "width", 1024))
            {
                Console.WriteLine("set window.width");
            }
            if (ConfigSetInt(h, "window", "height", 768))
            {
                Console.WriteLine("set window.height");
            }
            if (ConfigSetBool(h, "window", "maximized", false))
            {
                Console.WriteLine("set window.maximized");
            }
            if (ConfigSetDouble(h, "editor", "line_spacing", 1.25))
            {
                Console.WriteLine("set editor.line_spacing");
            }
            if (ConfigSet(h, "editor", "font", "Iosevka"))
            {
                Console.WriteLine("set editor.font");
            }
            if (ConfigSave(h))
            {
                Console.WriteLine("saved");
            }
            else
            {
                Console.WriteLine($"cannot save: {LastErrorText()}");
            }
            if (ConfigClose(h))
            {
                Console.WriteLine("closed");
            }
        }
        // --- read it back ------------------------------------------------------
        h = ConfigOpen(path);
        Console.WriteLine(ConfigPath(h));
        Console.WriteLine(ConfigGet(h, "window", "title"));
        Console.WriteLine(ConfigGetInt(h, "window", "width", 640));
        Console.WriteLine(ConfigGetDouble(h, "editor", "line_spacing", 1.0));
        if (ConfigGetBool(h, "window", "maximized", true))
        {
            Console.WriteLine("maximized");
        }
        else
        {
            Console.WriteLine("not maximized");
        }
        // A missing key is not a failure: the answer is the fallback you supplied,
        // and LastErrorCode() stays 0. ConfigHas is the predicate that tells
        // "not set" apart from "set to exactly that value".
        Console.WriteLine(ConfigGetInt(h, "window", "depth", 32));
        Console.WriteLine(LastErrorCode());
        if (ConfigHas(h, "window", "depth"))
        {
            Console.WriteLine("depth is set");
        }
        else
        {
            Console.WriteLine("depth is not set");
        }
        Console.WriteLine("[" + ConfigGet(h, "window", "nothing_here") + "]");
        // A missing FILE, on the other hand, is a failure: handle 0, and a reason in
        // LastErrorText().
        Console.WriteLine(ConfigOpen("/tmp/kiln-configlib-absent.ini"));
        Console.WriteLine(LastErrorText());
        // --- walk it: a count plus an accessor by position ---------------------
        // Positions count from 1, so `1..count` (both ends included) visits each one.
        foreach (var s in 1..ConfigSectionCount(h))
        {
            let name = ConfigSectionAt(h, s);
            Console.WriteLine($"[{name}]");
            foreach (var k in 1..ConfigKeyCount(h, name))
            {
                let key = ConfigKeyAt(h, name, k);
                Console.WriteLine($"  {key} = {ConfigGet(h, name, key)}");
            }
        }
        // --- change one setting, leaving everything else where it was ----------
        if (ConfigSetInt(h, "window", "width", 1280))
        {
            Console.WriteLine("width changed");
        }
        if (ConfigRemove(h, "editor", "font"))
        {
            Console.WriteLine("removed editor.font");
        }
        // Removing something that was never there is a genuine "no", not a failure:
        // false with LastErrorCode() at 0.
        if (!ConfigRemove(h, "editor", "font"))
        {
            Console.WriteLine($"nothing to remove, code {LastErrorCode()}");
        }
        if (!ConfigSave(h))
        {
            Console.WriteLine($"cannot save: {LastErrorText()}");
        }
        h = ConfigOpen(path);
        Console.WriteLine(ConfigGetInt(h, "window", "width", 0));
        Console.WriteLine(ConfigKeyCount(h, "editor"));
        // Section names match the way a person typed them, not the way a computer
        // would insist on.
        if (ConfigHasSection(h, "WINDOW"))
        {
            Console.WriteLine("the window section is there");
        }
        if (!ConfigHasSection(h, "toolbar"))
        {
            Console.WriteLine("the toolbar section is not");
        }
        Console.WriteLine(ConfigCloseAll());
    }
}
