# The `text` support library: string work beyond core's.
#
#   kiln run examples/textlib.kiln
module textlib
use text

sub main
  # --- predicates ---
  if text_starts_with("Kiln", "Open")
    call print_text("starts_with ok")
  end
  if text_ends_with("Kiln", "EPL")
    call print_text("ends_with ok")
  end
  if text_contains("Kiln", "nEP")
    call print_text("contains ok")
  end
  if text_equals_ignore_case("Kiln", "kiln")
    call print_text("equals_ignore_case ok")
  end

  # --- positions, in characters ---
  # "héllo" is five characters but six bytes: an index measured in bytes would
  # say 3 here, not 2.
  call print_int(length("héllo"))
  call print_int(text_index_of("héllo", "llo"))
  call print_int(text_index_of("héllo", "z"))
  call print_int(text_last_index_of("a-b-c", "-"))
  call print_int(text_count("a-b-c-d", "-"))
  call print_int(text_compare("apple", "banana"))
  call print_int(text_compare("pear", "pear"))
  call print_int(text_compare("pear", "peach"))

  # --- builders ---
  call print_text("[" + text_trim_start("  left  ") + "]")
  call print_text("[" + text_trim_end("  right  ") + "]")
  call print_text(text_pad_left("héllo", 8, "*"))
  call print_int(length(text_pad_left("héllo", 8, "*")))
  call print_text(text_pad_right("7", 4, "."))
  call print_text(text_title_case("the QUICK brown fox"))
  call print_text(text_insert("héllo", 1, "-"))
  call print_text(text_remove("héllo world", 5, 6))

  # --- characters and code points ---
  call print_text(text_char_at("héllo", 1))
  call print_int(text_char_code("héllo", 1))
  call print_text(text_from_code(233))
  call print_text(text_from_code(9731))

  # --- splitting: a count plus an indexed accessor ---
  # A trailing separator makes a real (empty) final field.
  let parts = text_split_count("a,,b,", ",")
  call print_int(parts)
  # Fields count from 1: "a", "", "b", "" — the trailing separator makes the
  # fourth one real.
  call print_text("[" + text_split_at("a,,b,", ",", 1) + "]")
  call print_text(text_split_at("a,,b,", ",", 3))
  call print_text("[" + text_split_at("a,,b,", ",", 4) + "]")

  # --- failure reporting ---
  # "" from a bad code point, with the reason left in the error slot.
  let bad_code = -1
  let bad = text_from_code(bad_code)
  let code = last_error_code()
  call print_int(code)
  call print_text(last_error_text())

  # A success clears the slot again, so the next check reads a true 0.
  let good = text_split_count("a,b", ",")
  let after = last_error_code()
  call print_int(good)
  call print_int(after)

  # An out-of-range index is a failure, not an empty character.
  let missing = text_char_at("hi", 9)
  call print_int(last_error_code())
end
