// The `text` support library: string work beyond core's.
//
//   kiln run examples/textlib.kiln

namespace Textlib;

using Kiln.Text;

public static class Textlib
{
    public static void Main()
    {
        // --- predicates ---
        if (TextStartsWith("Kiln", "Open"))
        {
            Console.WriteLine("starts_with ok");
        }
        if (TextEndsWith("Kiln", "EPL"))
        {
            Console.WriteLine("ends_with ok");
        }
        if (TextContains("Kiln", "nEP"))
        {
            Console.WriteLine("contains ok");
        }
        if (TextEqualsIgnoreCase("Kiln", "kiln"))
        {
            Console.WriteLine("equals_ignore_case ok");
        }
        // --- positions, in characters ---
        // "héllo" is five characters but six bytes: an index measured in bytes would
        // say 3 here, not 2.
        Console.WriteLine(Length("héllo"));
        Console.WriteLine(TextIndexOf("héllo", "llo"));
        Console.WriteLine(TextIndexOf("héllo", "z"));
        Console.WriteLine(TextLastIndexOf("a-b-c", "-"));
        Console.WriteLine(TextCount("a-b-c-d", "-"));
        Console.WriteLine(TextCompare("apple", "banana"));
        Console.WriteLine(TextCompare("pear", "pear"));
        Console.WriteLine(TextCompare("pear", "peach"));
        // --- builders ---
        Console.WriteLine("[" + TextTrimStart("  left  ") + "]");
        Console.WriteLine("[" + TextTrimEnd("  right  ") + "]");
        Console.WriteLine(TextPadLeft("héllo", 8, "*"));
        Console.WriteLine(Length(TextPadLeft("héllo", 8, "*")));
        Console.WriteLine(TextPadRight("7", 4, "."));
        Console.WriteLine(TextTitleCase("the QUICK brown fox"));
        Console.WriteLine(TextInsert("héllo", 1, "-"));
        Console.WriteLine(TextRemove("héllo world", 5, 6));
        // --- characters and code points ---
        Console.WriteLine(TextCharAt("héllo", 1));
        Console.WriteLine(TextCharCode("héllo", 1));
        Console.WriteLine(TextFromCode(233));
        Console.WriteLine(TextFromCode(9731));
        // --- splitting: a count plus an indexed accessor ---
        // A trailing separator makes a real (empty) final field.
        let parts = TextSplitCount("a,,b,", ",");
        Console.WriteLine(parts);
        // Fields count from 1: "a", "", "b", "" — the trailing separator makes the
        // fourth one real.
        Console.WriteLine("[" + TextSplitAt("a,,b,", ",", 1) + "]");
        Console.WriteLine(TextSplitAt("a,,b,", ",", 3));
        Console.WriteLine("[" + TextSplitAt("a,,b,", ",", 4) + "]");
        // --- failure reporting ---
        // "" from a bad code point, with the reason left in the error slot.
        let badCode = -1;
        let bad = TextFromCode(badCode);
        let code = LastErrorCode();
        Console.WriteLine(code);
        Console.WriteLine(LastErrorText());
        // A success clears the slot again, so the next check reads a true 0.
        let good = TextSplitCount("a,b", ",");
        let after = LastErrorCode();
        Console.WriteLine(good);
        Console.WriteLine(after);
        // An out-of-range index is a failure, not an empty character.
        let missing = TextCharAt("hi", 9);
        Console.WriteLine(LastErrorCode());
    }
}
