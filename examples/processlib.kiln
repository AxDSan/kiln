// Running other programs: libs/process.
//
// The distinction the library is built around is "could not start" (-1 or
// handle 0, with an error code) versus "ran and failed" (its real exit status,
// no error).

namespace Processlib;

using Kiln.Process;

public static class Processlib
{
    public static void Main()
    {
        // --- run something and look at how it ended ---
        let ok = ProcessRun("true");
        Console.WriteLine($"true -> {ok}");
        let bad = ProcessRun("exit 3");
        Console.WriteLine($"exit 3 -> {bad}");
        Console.WriteLine($"  error code {LastErrorCode()}");
        let missing = ProcessRun("/nonexistent/program");
        Console.WriteLine($"missing -> {missing}");
        if (LastErrorCode() != 0)
        {
            Console.WriteLine("  it could not start, and said so");
        }
        // --- capture what it said ---
        Console.WriteLine(Trim(ProcessRunCapture("echo captured output")));
        // --- a child kept alive, talked to line by line ---
        var h = ProcessStart("while read line; do echo \"got: $line\"; done");
        if (h == 0)
        {
            Console.WriteLine("could not start the child");
        }
        else
        {
            Console.WriteLine("started");
            if (ProcessWriteLine(h, "one"))
            {
                Console.WriteLine(ProcessReadLine(h));
            }
            if (ProcessWriteLine(h, "two"))
            {
                Console.WriteLine(ProcessReadLine(h));
            }
            if (ProcessIsRunning(h))
            {
                Console.WriteLine("still running");
            }
            let status = ProcessWait(h);
            Console.WriteLine($"child exit -> {status}");
            if (ProcessIsRunning(h))
            {
                Console.WriteLine("BUG: still running after wait");
            }
            else
            {
                Console.WriteLine("finished");
            }
            if (ProcessClose(h))
            {
                Console.WriteLine("closed");
            }
        }
        // --- reading to the end: "" is ambiguous, so the predicate sits beside it ---
        // A raw literal carries the backslashes through untouched, so printf is the
        // one that turns `\n` into newlines.
        var lines = ProcessStart("printf 'alpha\\nbeta\\n\\ngamma\\n'");
        int count = 0;
        while (count < 10)
        {
            let line = ProcessReadLine(lines);
            if (ProcessAtEnd(lines))
            {
                break;
            }
            Console.WriteLine($"line: [{line}]");
            count = count + 1;
        }
        Console.WriteLine("end of output");
        if (ProcessClose(lines))
        {
            Console.WriteLine("reader closed");
        }
        // --- a child that outlives its usefulness ---
        let sleeper = ProcessStart("sleep 30");
        if (ProcessIsRunning(sleeper))
        {
            Console.WriteLine("sleeper is running");
        }
        if (ProcessKill(sleeper))
        {
            Console.WriteLine("sleeper killed");
        }
        Console.WriteLine(ProcessCloseAll());
    }
}
