# Starting a thread and starting a process, with nothing but `use win`.
#
#   kiln build examples/win/spawn.kiln --os windows -o spawn.exe
#
# Two things are being proved here that nothing else in `examples/win` proves.
#
# A THREAD runs an Kiln subroutine on a stack Windows made: `address of`
# hands CreateThread a real function pointer with the ThreadProc shape, and
# what the sub returns comes back out of GetExitCodeThread. Windows is
# calling into this program on a thread this program never created.
#
# A PROCESS is the STARTUPINFOA/PROCESS_INFORMATION pair — two structs the
# whole call turns on, one of which (STARTUPINFOA, 104 bytes) has two WORDs
# in the middle of it and would silently misalign if the record were wrong.
#
# Every line prints `<label> ok` or `<label> FAILED`.
module spawn
use win

# What the thread leaves behind, so the main thread can see it ran.
var thread_ran: int = 0

sub say(label: text, ok: bool)
  if ok
    call print_text(label + " ok")
  else
    call print_text(label + " FAILED")
  end
end

# A Win32 ThreadProc: `DWORD WINAPI proc(LPVOID)`. The parameter is the
# LPVOID CreateThread was given; the return is the thread's exit code.
sub worker(parameter: ptr): int system
  thread_ran = ptr_read_int(parameter, 0)
  return thread_ran * 2
end

sub main
  # --- a thread ---------------------------------------------------------
  let inbox: ptr = mem_alloc(4)
  call ptr_write_int(inbox, 0, 21)

  let thread: ptr = CreateThread(ptr_null(), 0, address of worker, inbox, 0, ptr_null())
  if ptr_is_null(thread)
    call print_text("thread FAILED {GetLastError()}")
    return
  end
  call say("thread", true)
  call say("wait", WaitForSingleObject(thread, 5000) = WAIT_OBJECT_0)

  let code: ptr = mem_alloc(4)
  call mem_zero(code, 4)
  call say("exit code", GetExitCodeThread(thread, code))
  call say("thread returned", ptr_read_int(code, 0) = 42)
  call say("thread saw parameter", thread_ran = 21)
  call CloseHandle(thread)

  # --- a process --------------------------------------------------------
  # `cbSize` on STARTUPINFOA is `cb`, and it must be the struct's own size
  # before CreateProcessA will look at it. The command line is a `text`
  # because this program always supplies one; the application name is a
  # `ptr` because NULL is the normal thing to pass there.
  var startup: STARTUPINFOA
  var info: PROCESS_INFORMATION
  startup.cb = int64_to_int(size of STARTUPINFOA)

  let started: bool = CreateProcessA(ptr_null(), "cmd.exe /c exit 7", ptr_null(), ptr_null(), false, CREATE_NO_WINDOW, ptr_null(), ptr_null(), startup, info)
  call say("create process", started)
  if started
    call say("process wait", WaitForSingleObject(info.hProcess, 20000) = WAIT_OBJECT_0)
    call mem_zero(code, 4)
    call say("process exit", GetExitCodeProcess(info.hProcess, code))
    call say("process code", ptr_read_int(code, 0) = 7)
    call CloseHandle(info.hThread)
    call CloseHandle(info.hProcess)
  end

  call mem_free(inbox)
  call mem_free(code)
  call print_text("done")
end
