# The Win32 half of the same story: an address the loader hands back is called,
# and the kit's constants are combined and tested as the bits they are.
#
# Both were gaps the win kit was written around. `GetProcAddress` answered with
# a `ptr` that nothing could call, so an export had to be declared ahead of
# time; and with no bitwise operator, flags were added together and a single
# bit could not be read out of a word at all. This program does neither the old
# way. Every line prints `ok` or `FAIL`, so running it under wine is the test.
module flags
use win

sub say(what: text, passed: bool)
  if passed
    call print_text("ok " + what)
  else
    call print_text("FAIL " + what)
  end
end

sub main
  # --- an address, fetched and called ---------------------------------------
  # kernel32 is already in the process; LoadLibraryA takes its reference count
  # up and hands back the same base address a declared import resolves through.
  let k32: ptr = LoadLibraryA("kernel32.dll")
  if ptr_is_null(k32)
    call print_text("FAIL kernel32.dll did not load")
    return
  end

  # The strongest check available for an indirect call: the same function,
  # reached both ways. `GetCurrentProcessId` is declared in the kit and linked
  # by name, and is also looked up as a string and called through its address.
  # One process has one id, so the two answers must be the same number.
  let by_name: int = GetCurrentProcessId()
  let by_address: ptr = GetProcAddress(k32, "GetCurrentProcessId")
  call say("GetProcAddress found GetCurrentProcessId", ptr_is_null(by_address) = false)
  call say("the address answers what the import does", call through by_address(): int system = by_name)

  # An export that is not there answers null rather than misbehaving, which is
  # what GetProcAddress is for once every export can be called.
  call say("a missing export is null", ptr_is_null(GetProcAddress(k32, "NoSuchExportW")))

  # --- flags, combined and tested ------------------------------------------
  # The kit declares MEM_COMMIT_RESERVE pre-combined because adding the pair by
  # hand invited a mistake. `bor` is what it was standing in for.
  call say("MEM_COMMIT bor MEM_RESERVE is the pair", MEM_COMMIT bor MEM_RESERVE = MEM_COMMIT_RESERVE)
  # Disjoint bits, so `+` and `bor` agree — which is why the older spelling was
  # not wrong, only unable to say what it meant.
  call say("bor agrees with + on disjoint flags", MB_ICONINFORMATION bor MB_DEFBUTTON2 = MB_ICONINFORMATION + MB_DEFBUTTON2)

  # A style word, read one bit at a time. WS_OVERLAPPEDWINDOW carries a border
  # and does not carry WS_VISIBLE, and now that can be asked rather than known.
  call say("WS_OVERLAPPEDWINDOW has a border", WS_OVERLAPPEDWINDOW band WS_BORDER <> 0)
  call say("WS_OVERLAPPEDWINDOW is not visible", WS_OVERLAPPEDWINDOW band WS_VISIBLE = 0)
  # WS_POPUP is written in the kit as the decimal -2147483648, because it was
  # transcribed before hex literals existed. It is the same 32 bits either way.
  call say("WS_POPUP is the top bit", WS_POPUP band 0x8000_0000 <> 0)
  # A style built up and then one flag taken away again.
  var style: int = WS_OVERLAPPEDWINDOW bor WS_VISIBLE
  call say("a flag can be cleared", style band bnot WS_VISIBLE = WS_OVERLAPPEDWINDOW)

  # A packed pair of 16-bit halves, the shape every mouse message's LPARAM has.
  let packed: int = (480 shl 16) bor 640
  call say("LOWORD", packed band 0xFFFF = 640)
  call say("HIWORD", packed ushr 16 band 0xFFFF = 480)

  # --- the flags in a real call --------------------------------------------
  # VirtualAlloc, with its type word combined here rather than pre-combined in
  # the kit. Nothing about the call changes; the number reaching Windows is the
  # same one.
  let page: ptr = VirtualAlloc(ptr_null(), 4096, MEM_COMMIT bor MEM_RESERVE, PAGE_READWRITE)
  call say("VirtualAlloc took a combined type word", ptr_is_null(page) = false)
  if ptr_is_null(page) = false
    call ptr_write_int(page, 0, 0xDEAD_BEEF)
    call say("the page holds what was written", ptr_read_int(page, 0) = 0xDEAD_BEEF)
    # MEM_RELEASE wants a size of zero: the whole reservation goes back.
    call say("VirtualFree", VirtualFree(page, 0, MEM_RELEASE))
  end

  # An access mask combined with `bor`, handed to OpenProcess for this very
  # process — the flags are read by Windows, not by this program.
  let me: ptr = OpenProcess(PROCESS_QUERY_INFORMATION bor PROCESS_VM_READ, false, GetCurrentProcessId())
  call say("OpenProcess took a combined access mask", ptr_is_null(me) = false)
  if ptr_is_null(me) = false
    call say("CloseHandle", CloseHandle(me))
  end

  call say("FreeLibrary", FreeLibrary(k32))
end
