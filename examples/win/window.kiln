# A real Win32 window, written with nothing but `use win`.
#
#   kiln build examples/win/window.kiln --os windows -o window.exe
#
# Not one `dll`, `record` or `const` line appears below: the class struct
# (WNDCLASSEXA), the message struct (MSG), the paint struct (PAINTSTRUCT),
# every WM_/WS_/CW_/SW_ number and every user32 and gdi32 entry point come
# from the kit. That is the whole point of this example — it is the proof
# that `use win` is enough to write a Windows program.
#
# The shape is the one every Win32 book opens with:
#
#   register a window class  ->  RegisterClassExA(WNDCLASSEXA)
#   create a window          ->  CreateWindowExA
#   pump messages            ->  PeekMessageA / TranslateMessage / DispatchMessageA
#   handle them in a WNDPROC ->  a sub whose address the class carries
#
# The WNDPROC is `address of wndproc` — a real C function pointer that Windows
# calls back on. Its signature is the pointer-width one a WNDPROC has: WPARAM,
# LPARAM and LRESULT are `int64`, the message is a `int`, the HWND is a `ptr`.
#
# It ends by itself. A window with a person in front of it lives until they
# close it; this one runs a fixed number of pump turns and then destroys its
# own window, so it can be built by a test, run to completion and checked.
# WM_DESTROY posts WM_QUIT the way a real program's does, so the exit path is
# the real one and not a shortcut around it.
module window
use win

# The class name is written once and used three times: registering, creating,
# and unregistering on the way out.
const CLASS_NAME = "KilnWindowClass"

# How many turns of the pump before the window is asked to close, and the hard
# ceiling that stops the program even if that ask is somehow never answered.
const CLOSE_AFTER = 60
const FRAME_BUDGET = 400

# What the WNDPROC saw. It runs on Windows' own call, not on any line below,
# so counting in module state is how `main` finds out what happened.
var paints: int = 0
var destroys: int = 0

# The window procedure. Windows calls this; Kiln does not.
sub wndproc(hwnd: ptr, msg: int, wparam: int64, lparam: int64): int64 system
  if msg = WM_PAINT
    # BeginPaint hands back a device context and fills the PAINTSTRUCT with
    # the rectangle that needs repainting; EndPaint releases it. Between them
    # is the drawing, and gdi32's TextOutA is the smallest drawing there is.
    var ps: PAINTSTRUCT
    let dc: ptr = BeginPaint(hwnd, ps)
    call TextOutA(dc, 10, 10, "Built with Kiln.", 19)
    call EndPaint(hwnd, ps)
    paints += 1
    call print_text("paint")
    return int_to_int64(0)
  end

  if msg = WM_DESTROY
    # The window is going away. PostQuitMessage puts WM_QUIT in the queue,
    # which is what ends the pump in `main`.
    destroys += 1
    call print_text("destroy")
    call PostQuitMessage(0)
    return int_to_int64(0)
  end

  # Everything else is Windows' business, not ours.
  return DefWindowProcA(hwnd, msg, wparam, lparam)
end

sub main
  # GetModuleHandleA(NULL) is the running .exe's own module. The kit binds the
  # nullable spelling under `GetModuleHandleNull`, because a `text` parameter
  # has no NULL to pass.
  let instance: ptr = GetModuleHandleNull(ptr_null())

  # A c-record local starts zeroed, which is exactly what a WNDCLASSEXA wants:
  # every field not set below is a documented "none".
  var wc: WNDCLASSEXA
  wc.cb_size = int64_to_int(size of WNDCLASSEXA)   # how the API versions the struct
  wc.style = CS_HREDRAW bor CS_VREDRAW             # redraw on either resize
  wc.wnd_proc = address of wndproc
  wc.instance = instance
  wc.cursor = LoadCursorA(ptr_null(), ptr_from_int(int_to_int64(IDC_ARROW)))
  wc.background = ptr_from_int(int_to_int64(COLOR_WINDOW + 1))
  wc.class_name = CLASS_NAME

  let atom: int = RegisterClassExA(wc)
  if atom = 0
    call print_text("register FAILED {GetLastError()}")
    return
  end
  call print_text("registered")

  # Twelve arguments, in the order CreateWindowExA has always taken them:
  # extended style, class, title, style, x, y, width, height, parent, menu,
  # instance, and the LPVOID handed to WM_CREATE.
  let hwnd: ptr = CreateWindowExA(0, CLASS_NAME, "Kiln", WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, 360, 220, ptr_null(), ptr_null(), instance, ptr_null())
  if ptr_is_null(hwnd)
    call print_text("create FAILED {GetLastError()}")
    return
  end
  call print_text("created")

  call ShowWindow(hwnd, SW_SHOW)
  call UpdateWindow(hwnd)        # forces the first WM_PAINT now, not later

  # The pump. PeekMessageA rather than GetMessageA because GetMessageA blocks
  # until a message arrives, and this program must finish on its own.
  var msg: MSG
  var frames: int = 0
  while frames < FRAME_BUDGET
    frames += 1
    if PeekMessageA(msg, ptr_null(), 0, 0, PM_REMOVE)
      if msg.message = WM_QUIT
        break
      end
      call TranslateMessage(msg)
      call DispatchMessageA(msg)
    end
    if frames = CLOSE_AFTER
      # What clicking the close box would do, minus the person.
      call DestroyWindow(hwnd)
    end
  end

  call UnregisterClassA(CLASS_NAME, instance)

  call print_text("paints {paints}")
  call print_text("destroys {destroys}")
  call print_text("frames {frames}")
end
