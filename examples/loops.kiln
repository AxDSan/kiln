// Counting, and leaving a loop early.
//
//   kiln build examples/loops.kiln -o loops
//   ./loops
//
//   foreach (var i in 1..10)             counts up; `1..10` is inclusive at both
//                                        ends, and `i` belongs to the loop
//   for (var i = 10; i >= 1; i--)        counts any other way: a start, a
//                                        condition checked before each turn,
//                                        and a step taken after it
//   break;                               leave the innermost loop now
//   continue;                            go straight to the next turn of it
//
// A `foreach` over a range reads its start and limit ONCE, before the first
// turn, so its body cannot make the loop longer. A `for` checks its condition
// every turn, which is the flexibility and the risk: prefer `foreach` when you
// are simply counting.
//
// A loop variable lives only inside its loop, and a local declared in a block
// lives only inside that block.

namespace Loops;

public static class Loops
{
    public static void Main()
    {
        Console.WriteLine("-- fizzbuzz, counted --");
        foreach (var n in 1..15)
        {
            Console.WriteLine(Fizzbuzz(n));
        }

        Console.WriteLine("-- counting down --");
        for (var down = 5; down >= 1; down--)
        {
            Console.WriteLine(down);
        }

        // `continue` skips the rest of this turn; `break` ends the loop. Together
        // they are how you say "the first one that fits" without a flag variable.
        Console.WriteLine("-- first multiple of 7 above 100 --");
        foreach (var hit in 101..200)
        {
            if (hit % 7 != 0)
            {
                continue;
            }
            Console.WriteLine(hit);
            break;
        }

        // `break` and `continue` work in a `while` too. `while (true)` runs until
        // a `break` leaves it.
        Console.WriteLine("-- three vowel-free words --");
        int found = 0;
        int i = 0;
        while (true)
        {
            i++;
            if (i > 100)
            {
                break;
            }
            string word = Candidate(i);
            if (word == "")
            {
                continue;
            }
            Console.WriteLine(word);
            found++;
            if (found == 3)
            {
                break;
            }
        }

        // Loops nest, and `break` leaves only the innermost one.
        Console.WriteLine("-- times table --");
        foreach (var row in 1..4)
        {
            string line = "";
            foreach (var col in 1..9)
            {
                if (col > row)
                {
                    break;
                }
                line = $"{line}{row * col} ";
            }
            Console.WriteLine(line);
        }
    }

    // Each `return` leaves the method at once, so the checks read top to bottom
    // with no `else`.
    public static string Fizzbuzz(int n)
    {
        if (n % 15 == 0)
        {
            return "FizzBuzz";
        }
        if (n % 3 == 0)
        {
            return "Fizz";
        }
        if (n % 5 == 0)
        {
            return "Buzz";
        }
        return $"{n}";
    }

    // Every third number names a word; the rest name nothing (the empty string).
    public static string Candidate(int i)
    {
        if (i % 3 != 0)
        {
            return "";
        }
        return $"word-{i}";
    }
}
