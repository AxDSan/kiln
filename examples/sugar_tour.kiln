// The 0.8.0 shorthands in one program: compound assignment, text `+` and `*`,
// string interpolation, a range loop, `for each` over a dictionary, `in` /
// `not in`, and a one-line `if`. Each binding drops its type — 0.9.0 infers it
// from the value — but every shorthand here is pure sugar over what the language
// already had, so the output is exactly what the longhand would print.

namespace SugarTour;

public static class SugarTour
{
    public static void Main()
    {
        // Compound assignment changes a target in place: `x += e` is `x = x + e`.
        var total = 0;
        total = total + 10;
        total = total * 3;
        total = total - 5;
        Console.WriteLine(total);
        // `text * n` repeats, `text + text` joins, and a `{hole}` interpolates.
        var rule = Repeat("=", 10);
        Console.WriteLine(rule);
        var who = "Ki" + "ln";
        Console.WriteLine($"hello, {who}");
        // A range loop counts inclusively from 1; the binding is the value.
        var sum = 0;
        foreach (var i in 1..5)
        {
            sum = sum + i;
        }
        Console.WriteLine(sum);
        foreach (var n in 1..3)
        {
            Console.WriteLine($"line {n}");
        }
        // `for each` over a dictionary binds key and value, in the order the keys
        // were added — so a walk of one is reproducible, here and everywhere.
        var prices = new Dictionary<string, int> { ["pen"] = 2, ["cup"] = 5, ["map"] = 8 };
        var cost = 0;
        foreach (var (item, price) in prices)
        {
            cost = cost + price;
        }
        Console.WriteLine(cost);
        if (prices.ContainsKey("cup"))
        {
            // `in` and `not in` test membership; over a dictionary they ask by key.
            Console.WriteLine("cup is stocked");
        }
        if (!prices.ContainsKey("hat"))
        {
            Console.WriteLine("no hat");
        }
        // A one-line `if` carries a single statement.
        var stock = 3;
        if (stock < 5)
        {
            stock = stock + 1;
        }
        Console.WriteLine(stock);
    }
}
