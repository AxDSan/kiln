// The everyday shorthands in one program: compound assignment, text `+` and
// `Repeat`, string interpolation, a range loop, `foreach` over a dictionary,
// `ContainsKey` for membership, and an `if` guarding a single statement. Each
// `var` drops its type — the compiler infers it from the value — and every
// shorthand is plain sugar, so the output is exactly what the longhand prints.
//
//   kiln build examples/sugar_tour.kiln -o sugar_tour

namespace SugarTour;

public static class SugarTour
{
    public static void Main()
    {
        // Compound assignment changes a target in place: `x += e` is `x = x + e`.
        var total = 0;
        total += 10;
        total *= 3;
        total -= 5;
        Console.WriteLine(total);               // 25
        // `Repeat` copies a text n times, `+` joins two, and a `$"…{hole}…"`
        // string interpolates the value of the expression in the braces.
        var rule = Repeat("=", 10);
        Console.WriteLine(rule);                // ==========
        var who = "Ki" + "ln";
        Console.WriteLine($"hello, {who}");     // hello, Kiln
        // A range `a..b` includes both ends; the loop variable is the value.
        var sum = 0;
        foreach (var i in 1..5)
        {
            sum += i;
        }
        Console.WriteLine(sum);                 // 15 (1+2+3+4+5)
        foreach (var n in 1..3)
        {
            Console.WriteLine($"line {n}");     // line 1 / line 2 / line 3
        }
        // `foreach` over a dictionary deconstructs each entry into key and value,
        // in the order the keys were added — so a walk of one is reproducible.
        var prices = new Dictionary<string, int> { ["pen"] = 2, ["cup"] = 5, ["map"] = 8 };
        var cost = 0;
        foreach (var (item, price) in prices)
        {
            cost += price;
        }
        Console.WriteLine(cost);                // 15 (2+5+8)
        // `ContainsKey` asks whether a key is present; `!` asks the opposite.
        if (prices.ContainsKey("cup"))
        {
            Console.WriteLine("cup is stocked");
        }
        if (!prices.ContainsKey("hat"))
        {
            Console.WriteLine("no hat");
        }
        // An `if` around one statement: add one to the stock while it is low.
        var stock = 3;
        if (stock < 5)
        {
            stock += 1;
        }
        Console.WriteLine(stock);               // 4
    }
}
