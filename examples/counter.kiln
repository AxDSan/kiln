// An app that changes at run time: clicking increments a counter.
//
// The count lives in a module variable — state that outlives any single event
// handler — rather than being read back out of the UI.

namespace Counter;

using Kiln.Ui;

public partial form MainWindow
{
    Title = "Kiln — counter";
    Width = 420;
    Height = 240;
    BackgroundColor = "#1e2233";

    Label countLabel
    {
        Text = "0";
        Left = 40;
        Top = 40;
        Width = 340;
        Color = "#ffffff";
    }

    Button addButton
    {
        Text = "Add one";
        Left = 40;
        Top = 110;
        Width = 160;
        Height = 44;
        BorderRadius = 8;
        Click += OnAdd;
    }
}

public partial form MainWindow
{
    int count = 0;

    void OnAdd()
    {
        count = count + 1;
        if (count >= 10)
        {
            countLabel.Text = $"{count} — that's enough!";
            addButton.Text = "Done";
        }
        else if (count == 1)
        {
            countLabel.Text = "1 (first click)";
        }
        else
        {
            countLabel.Text = count.ToString();
        }
        Console.WriteLine($"count = {count}");
    }
}
