// The `math` support library — what core arithmetic leaves out.
//
//   kiln run examples/mathlib.kiln
//
// Core already has sqrt, sin/cos/tan, pow, exp, ln, log10, floor/ceil/round,
// abs and min/max. This library adds the inverse and hyperbolic functions, the
// constants, angle conversion, interpolation, and the integer functions that
// have no floating-point form.

namespace Mathlib;

using Kiln.Math;

public static class Mathlib
{
    // Every check goes through here, which is what a subroutine with parameters is
    // for. Doubles are compared with a tolerance because binary floating point does
    // not represent most decimals exactly — `0.1 + 0.2 = 0.3` is false in every
    // language with IEEE-754 doubles, including this one.
    public static void Near(string label, double got, double want)
    {
        let diff = AbsDouble(got - want);
        if (diff < 0.000000001)
        {
            Console.WriteLine($"ok   {label}");
        }
        else
        {
            Console.WriteLine($"FAIL {label}: got {got}");
        }
    }

    public static void Truth(string label, bool got)
    {
        if (got)
        {
            Console.WriteLine($"ok   {label}");
        }
        else
        {
            Console.WriteLine($"FAIL {label}");
        }
    }

    public static void Same(string label, int got, int want)
    {
        if (got == want)
        {
            Console.WriteLine($"ok   {label}");
        }
        else
        {
            Console.WriteLine($"FAIL {label}: got {got}");
        }
    }

    public static void Main()
    {
        Console.WriteLine("-- constants --");
        Near("pi", MathPi(), 3.141592653589793);
        Near("tau is two pi", MathTau(), 2.0 * MathPi());
        Near("e", MathE(), 2.718281828459045);
        Console.WriteLine("-- inverse trigonometry --");
        Near("asin(1) is a quarter turn", MathAsin(1.0), MathPi() / 2.0);
        Near("acos(1) is zero", MathAcos(1.0), 0.0);
        Near("atan2(1, 1) is an eighth turn", MathAtan2(1.0, 1.0), MathPi() / 4.0);
        // atan2 knows its quadrant; atan alone cannot.
        Near("atan2 keeps the quadrant", MathAtan2(-1.0, -1.0), -3.0 * MathPi() / 4.0);
        Console.WriteLine("-- hyperbolic --");
        Near("cosh(0)", MathCosh(0.0), 1.0);
        Near("tanh flattens to 1", MathTanh(20.0), 1.0);
        Console.WriteLine("-- logarithms and roots --");
        Near("log2(1024)", MathLog2(1024.0), 10.0);
        Near("log base 3 of 81", MathLogBase(81.0, 3.0), 4.0);
        Near("cbrt(27)", MathCbrt(27.0), 3.0);
        Near("hypot(3, 4)", MathHypot(3.0, 4.0), 5.0);
        Console.WriteLine("-- rounding --");
        Near("trunc cuts toward zero", MathTrunc(-2.7), -2.0);
        Near("round_to two places", MathRoundTo(3.14159, 2), 3.14);
        Near("fmod(7.5, 2)", MathFmod(7.5, 2.0), 1.5);
        Console.WriteLine("-- range and interpolation --");
        Near("clamp holds the ceiling", MathClamp(99.0, 0.0, 1.0), 1.0);
        Near("lerp halfway", MathLerp(10.0, 20.0, 0.5), 15.0);
        // Written as a + t*(b - a), so the end point comes back exactly.
        Near("lerp at 1 is exactly b", MathLerp(10.0, 20.0, 1.0), 20.0);
        Same("sign of a negative", MathSign(-4.5), -1);
        Same("clamp_int", MathClampInt(50, 1, 10), 10);
        Console.WriteLine("-- angles --");
        Near("180 degrees is pi", MathRadians(180.0), MathPi());
        Near("and back again", MathDegrees(MathPi()), 180.0);
        Console.WriteLine("-- integers --");
        Same("gcd(48, 18)", MathGcd(48, 18), 6);
        Same("lcm(4, 6)", Int64ToInt(MathLcm(4, 6)), 12);
        // 20! is 2432902008176640000 — it fits in int64 and nothing smaller.
        Truth("20! is exact", TextEq(Int64ToText(MathFactorial(20)), "2432902008176640000"));
        Truth("7 is prime", MathIsPrime(7));
        Truth("1 is not prime", !MathIsPrime(1));
        Truth("large prime", MathIsPrime(7919));
        Console.WriteLine("-- failure reporting --");
        // A double command with no answer returns NaN and sets the slot. NaN is not
        // equal to itself, so math_is_nan is the only way to test for it.
        let bad = MathAsin(2.0);
        if (MathIsNan(bad) && LastErrorCode() != 0)
        {
            Console.WriteLine($"ok   asin(2) refused: {LastErrorText()}");
        }
        else
        {
            Console.WriteLine("FAIL asin(2) should have failed");
        }
        if (TextEq(Int64ToText(MathFactorial(21)), "-1"))
        {
            Console.WriteLine($"ok   21! refused: {LastErrorText()}");
        }
        else
        {
            Console.WriteLine("FAIL 21! should have overflowed");
        }
        // A success clears the slot, so a stale code is never mistaken for a fresh one.
        Near("recovered", MathAsin(0.0), 0.0);
        Same("slot cleared by the next success", LastErrorCode(), 0);
    }
}
