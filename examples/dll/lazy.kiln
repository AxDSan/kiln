// A `dll` is loaded at its first call, not at start-up: this declares a foreign
// function from a library that is not present, never calls it, and runs cleanly.

namespace Dlllazy;

public static class Dlllazy
{
    [Dll("an_absent_library", Entry = "never_called")]
    public static extern int NeverCalled(int a);

    public static void Main()
    {
        Console.WriteLine("lazy ok");
    }
}
