// A `[Dll]` library is loaded at the method's first call, not at start-up: this
// declares an `extern` method from a library that is not present, never calls
// it, and runs cleanly.

namespace Dlllazy;

public static class Dlllazy
{
    [Dll("an_absent_library", Entry = "never_called")]
    public static extern int NeverCalled(int a);

    public static void Main()
    {
        Console.WriteLine("lazy ok");
    }
}
