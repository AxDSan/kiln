// Reaching for a symbol the library does not export is a named run-time error.

namespace Dllbadsym;

public static class Dllbadsym
{
    [Dll("mathdll", Entry = "does_not_exist")]
    public static extern int Nope(int x);

    public static void Main()
    {
        Console.WriteLine(Nope(1));
    }
}
