// Calling a C library through `dll`. The library is `libmathdll.so`, built from
// `mathdll.c` and sitting beside this program.

namespace Dllmath;

public static class Dllmath
{
    [Dll("mathdll", Entry = "add_ints")]
    public static extern int AddInts(int a, int b);

    [Dll("mathdll", Entry = "banner")]
    public static extern string Banner();

    [Dll("mathdll", Entry = "bump")]
    public static extern void Bump(Ptr cell);

    [Dll("mathdll", Entry = "times_ten")]
    public static extern int Tentimes(int x);

    [Dll("mathdll", Entry = "add_bignums")]
    public static extern long AddBignums(long a, long b);

    [Dll("mathdll", Entry = "halve")]
    public static extern double Halve(double x);

    [Dll("mathdll", Entry = "is_positive")]
    public static extern bool IsPositive(int x);

    public static void Main()
    {
        // A value in, a value out.
        Console.WriteLine(AddInts(40, 2));
        // A C string out, copied into a managed text.
        Console.WriteLine(Banner());
        // A pointer the callee writes through: a 4-byte cell, set to 41, bumped to 42.
        Ptr cell = MemAlloc(4);
        PtrWriteInt(cell, 0, 41);
        Bump(cell);
        Console.WriteLine(PtrReadInt(cell, 0));
        MemFree(cell);
        // The exported symbol is `times_ten`; `as` lets the program call it `tentimes`.
        Console.WriteLine(Tentimes(5));
        // int64, double and bool all cross the boundary.
        PrintInt64(AddBignums(9000000000, 1));
        Console.WriteLine(Halve(7.0));
        if (IsPositive(3))
        {
            Console.WriteLine("positive");
        }
    }
}
