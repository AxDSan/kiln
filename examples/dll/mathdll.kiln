# Calling a C library through `dll`. The library is `libmathdll.so`, built from
# `mathdll.c` and sitting beside this program.
module dllmath

dll add_ints(a: int, b: int): int from "mathdll"
dll banner(): text from "mathdll"
dll bump(cell: ptr) from "mathdll"
dll tentimes(x: int): int from "mathdll" as "times_ten"
dll add_bignums(a: int64, b: int64): int64 from "mathdll"
dll halve(x: double): double from "mathdll"
dll is_positive(x: int): bool from "mathdll"

sub main
  # A value in, a value out.
  call print_int(add_ints(40, 2))

  # A C string out, copied into a managed text.
  call print_text(banner())

  # A pointer the callee writes through: a 4-byte cell, set to 41, bumped to 42.
  let cell: ptr = mem_alloc(4)
  call ptr_write_int(cell, 0, 41)
  call bump(cell)
  call print_int(ptr_read_int(cell, 0))
  call mem_free(cell)

  # The exported symbol is `times_ten`; `as` lets the program call it `tentimes`.
  call print_int(tentimes(5))

  # int64, double and bool all cross the boundary.
  call print_int64(add_bignums(9000000000, 1))
  call print_double(halve(7.0))
  if is_positive(3)
    call print_text("positive")
  end
end
