# The operators that used to be commands.
#
#   kiln run examples/operators.kiln
#
# Three small gaps in the expression grammar, closed together. Each one was
# reachable before by calling a command or writing a workaround; the point is
# that a beginner should not have to know the workaround.
#
#   -x        negation. `let x: int = -5` used to be a parse error, and
#             examples wrote `0 - 1` to mean minus one.
#   a % b     remainder. `mod_int(a, b)` still exists and still works.
#   a + b     on text, joining. `concat(concat("[", x), "]")` is now
#             "[" + x + "]" — and, better still, the string interpolation
#             "[{x}]" that this same release added on top of it.
#
# `+` on two texts is exactly the `concat` command — same runtime call, same
# result — so nothing about how text is stored has changed.
module operators

# A negative literal is a literal: it may be as small as `int` goes.
sub main
  let freezing = -40
  call print_int(freezing)
  call print_int(-freezing)

  # Negation applies to any numeric expression, not just literals.
  var owed = 250
  call print_int(-owed)
  let below = -1.5
  call print_double(-below)

  # Remainder, and the classic thing it is for.
  call print_int(17 % 5)
  call print_int(-17 % 5)
  call print_text(parity(6))
  call print_text(parity(7))

  # Joining text. Read this line, then read the version underneath it.
  let who = "Ada"
  call print_text("Hello, " + who + " — you are " + int_to_text(36) + " today.")
  call print_text(concat(concat(concat(concat("Hello, ", who), " — you are "), int_to_text(36)), " today."))

  # Dividing by a value that turns out to be zero used to kill the process
  # with no message at all. It now stops with one — uncomment to see:
  #   var zero: int = 0
  #   call print_int(10 / zero)
end

sub parity(n: int): text
  return "{n} is even" if n % 2 = 0
  return "{n} is odd"
end
