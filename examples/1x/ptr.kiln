# Pointers and raw memory — the escape hatch to C.
#
#   kiln build examples/ptr.kiln -o ptr
#   ./ptr
#
# A `ptr` holds a raw machine address. These are the operations that let an
# Kiln program build a buffer or a struct and hand it to a C API.
module ptr

sub main
  # Allocate 16 bytes, write an int at offset 0 and an int64 at offset 8,
  # then read both back. Sizes and offsets are int64.
  var buf: ptr = mem_alloc(16)
  call mem_zero(buf, 16)
  call ptr_write_int(buf, 0, 42)
  call ptr_write_int64(buf, 8, 9000000000)
  call print_int(ptr_read_int(buf, 0))
  call print_int64(ptr_read_int64(buf, 8))

  # One byte reads as an int 0..255; a double round-trips its 8 bytes.
  call ptr_write_byte(buf, 4, 255)
  call print_int(ptr_read_byte(buf, 4))
  call ptr_write_double(buf, 0, 3.5)
  call print_double(ptr_read_double(buf, 0))

  # ptr_of_text hands a C API the char* behind a text; ptr_read_text copies
  # a C string back into a Kiln text.
  let greeting: text = "hello, C"
  var gp: ptr = ptr_of_text(greeting)
  call print_text(ptr_read_text(gp))

  # ptr_read_text is the one read that is safe at null: it answers "".
  call print_text(ptr_read_text(ptr_null()))

  # A two-pointer chain: cell -> leaf, walked back with ptr_read_ptr.
  var cell: ptr = mem_alloc(8)
  var leaf: ptr = mem_alloc(8)
  call ptr_write_int(leaf, 0, 7)
  call ptr_write_ptr(cell, 0, leaf)
  var walked: ptr = ptr_read_ptr(cell, 0)
  call print_int(ptr_read_int(walked, 0))

  # ptr_from_int / ptr_to_int round-trips an address through an int64.
  var again: ptr = ptr_from_int(ptr_to_int(leaf))
  call print_int(ptr_read_int(again, 0))

  # Two names for one address compare equal.
  if again = leaf
    call print_text("same")
  end

  # The null pointer answers ptr_is_null.
  if ptr_is_null(ptr_null())
    call print_text("null-ok")
  end

  # ptr_offset makes a pointer past the base; a write through it is visible
  # at the matching offset from the base.
  call ptr_write_int(ptr_offset(buf, 8), 0, 123)
  call print_int(ptr_read_int(buf, 8))

  # Copy a text's bytes (with its NUL) into a buffer the program owns.
  var name: ptr = mem_alloc(32)
  call ptr_write_text(name, 0, "Kiln")
  call print_text(ptr_read_text(name))

  call mem_free(buf)
  call mem_free(cell)
  call mem_free(leaf)
  call mem_free(name)
end
