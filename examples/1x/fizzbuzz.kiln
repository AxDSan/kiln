# Control flow: `match`, `for` over a range, comparisons and logical operators.
module fizzbuzz

sub main
  # One value tested against several: `match` is the if-chain, written the way
  # it reads. `n % 15` is 0 only on a multiple of both 3 and 5.
  for n in 1..20
    match n % 15
    when 0: call print_text("FizzBuzz")
    when 3, 6, 9, 12: call print_text("Fizz")
    when 5, 10: call print_text("Buzz")
    else: call print_int(n)
    end
  end

  # Short-circuit `and`: the right side is not evaluated when n is 0, so the
  # division is safe.
  let zero = 0
  if zero <> 0 and 100 % zero = 0
    call print_text("unreachable")
  else
    call print_text("short-circuit ok")
  end

  # Text equality compares content, not pointers; `+` joins, the same as concat.
  if "fizz" + "buzz" = "fizzbuzz"
    call print_text("text equality ok")
  end
end
