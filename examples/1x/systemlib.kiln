# The `system` library: the environment the program runs in.
#
#   kiln run examples/systemlib.kiln
module systemlib
use system

sub main
  # --- the machine ---
  call print_text("os: {os_name()}")
  call print_text("arch: {os_arch()}")

  # A host name and a home directory always exist on a working machine, so
  # print whether the query succeeded rather than the values themselves —
  # the output has to be the same on every machine to be checkable.
  let host = os_host_name()
  if last_error_code() = 0 and length(host) > 0
    call print_text("host name: ok")
  else
    call print_text("host name failed: {last_error_text()}")
  end

  let home = os_home_dir()
  if last_error_code() = 0 and length(home) > 0
    call print_text("home dir: ok")
  end

  # --- the environment block ---
  if env_set("KILN_DEMO", "hello")
    call print_text("KILN_DEMO = " + env_get("KILN_DEMO"))
  end

  # A variable set to nothing and a variable that is absent both read as "".
  # env_has is what tells them apart.
  if env_set("KILN_EMPTY", "")
    call print_text("set to empty")
  end
  if env_has("KILN_EMPTY") and text_eq(env_get("KILN_EMPTY"), "")
    call print_text("empty but present")
  end
  if env_unset("KILN_EMPTY")
    if env_has("KILN_EMPTY")
      call print_text("still there?")
    else
      call print_text("absent after unset")
    end
  end

  # An unset variable is a "no", not a failure: the error slot stays clear.
  let missing = env_get("KILN_NOT_SET_ANYWHERE")
  call print_int(last_error_code())
  call print_int(length(missing))

  # A name that cannot address a variable at all IS a failure.
  let bad = env_get("")
  if last_error_code() <> 0
    call print_text("rejected: {last_error_text()}")
  end

  # The block is a count plus an indexed accessor; PATH is in it.
  if env_count() > 0
    let first = env_name_at(1)
    if last_error_code() = 0 and length(first) > 0 and env_has(first)
      call print_text("environment is not empty")
    end
  end
  let past_block = env_name_at(env_count() + 1)
  if last_error_code() <> 0
    call print_text("env index out of range rejected")
  end

  # --- this process ---
  call print_text("pid: ok") if sys_process_id() > 0

  # sys_arg(1) is the first REAL argument — the program name is not one of
  # them, and lives in sys_program_path().  So a program run with no arguments
  # reports 0, which is what anyone would guess.
  call print_text("no arguments: ok") if sys_arg_count() = 0
  let past_end = sys_arg(9999)
  if last_error_code() <> 0
    call print_text("out of range rejected")
  end

  call print_text("program dir: ok") if length(sys_program_dir()) > 0 and last_error_code() = 0

  # --- timing ---
  let t0 = sys_tick_count()
  call sys_sleep_ms(60)
  let t1 = sys_tick_count()
  let waited = int64_to_int(t1 - t0)
  if 50 <= waited < 2000
    call print_text("slept about 60ms")
  else
    call print_text("suspicious wait: {waited}")
  end

  call print_text("done")
  call sys_quit(0)
  call print_text("unreachable")
end
