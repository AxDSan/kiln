# Files, directories and paths — the `file` support library.
#
#   kiln run examples/filelib.kiln
#
# Everything happens under a scratch directory the program creates and then
# removes, so running it twice leaves nothing behind.
module filelib
use file

# Every binary check below reports through here, the same shape arrays.kiln uses.
sub check(what: text, ok: bool)
  if ok
    call print_text("{what}: ok")
  else
    call print_text("{what}: FAIL")
  end
end

sub main
  let dir = "filelib-scratch"
  let note = dir + "/note.txt"

  # --- paths are pure text: they answer before anything exists ----------
  call print_text(path_name(note))
  call print_text(path_parent(note))
  call print_text(path_extension(note))
  call print_text(path_join("a/b/", "c.txt"))
  call print_text(path_name(path_absolute("x/../y.txt")))

  # --- create, write, read ----------------------------------------------
  if dir_create(dir)
    call print_text("made the directory")
  end
  if file_write_text(note, "alpha\nbeta\ngamma\n")
    call print_text("wrote the file")
  end
  call print_text(file_read_text(note))
  call print_int(file_line_count(note))
  call print_int64(file_size(note))

  if file_exists(note) and not dir_exists(note)
    call print_text("it is a file, not a directory")
  end

  # --- append, then read line by line through a handle -------------------
  if file_append_text(note, "delta\n")
    call print_text("appended")
  end
  var h = file_open(note, "read")
  var n: int = 0
  while not file_at_end(h)
    let line = file_read_line(h)
    increment n
    call print_text("{n}: {line}")
  end
  if file_close(h)
    call print_text("closed")
  end

  # A stale handle is a failure, not a crash.
  if not file_close(h)
    call print_text("second close: {last_error_text()}")
  end

  # --- copy, list, move, delete ------------------------------------------
  let copy = path_join(dir, "copy.txt")
  if file_copy(note, copy)
    call print_text("copied")
  end

  let count = dir_entry_count(dir)
  call print_int(count)
  for i in 1..count
    call print_text(dir_entry(dir, i))
  end

  let moved = path_join(dir, "moved.txt")
  if file_move(copy, moved) and not file_exists(copy)
    call print_text("moved")
  end

  # --- failure is a sentinel plus the error slot -------------------------
  let missing = file_read_text(path_join(dir, "nope.txt"))
  call print_text("missing file -> [{missing}]")
  if last_error_code() <> 0
    call print_text(last_error_text())
  end

  # false with code 0 is a genuine "no", not a failure.
  if not file_exists(path_join(dir, "nope.txt")) and last_error_code() = 0
    call print_text("absent, and that is an answer not an error")
  end

  # --- bytes: the path that survives a NUL --------------------------------
  # A PNG is full of NUL bytes, and text stops at the first one.  This is that
  # difference made visible: the same three bytes, read both ways.
  let blob = path_join(dir, "blob.bin")
  var raw: bytes = bytes_new(3)
  raw[1] = 65
  raw[2] = 0
  raw[3] = 66

  call check("file_write_bytes", file_write_bytes(blob, raw))
  call check("size on disk is 3", file_size(blob) = int_to_int64(3))

  let back = file_read_bytes(blob)
  call check("read back 3 bytes", bytes_count(back) = 3)
  call check("byte 1 survived", back[1] = 65)
  call check("the NUL survived", back[2] = 0)
  call check("byte 3 survived", back[3] = 66)

  # The text path truncates at the NUL — one character, not three.  That is
  # not a bug in file_read_text; it is what a C string is, and why the bytes
  # commands exist beside it.
  call check("the text path stops at the NUL", length(file_read_text(blob)) = 1)

  call check("file_append_bytes", file_append_bytes(blob, raw))
  let both = file_read_bytes(blob)
  call check("appending doubled it", bytes_count(both) = 6)
  call check("the second copy is intact", both[4] = 65 and both[5] = 0 and both[6] = 66)

  # Failure is an empty byte-set plus the error slot, the way "" is for text.
  let gone = file_read_bytes(path_join(dir, "no-such.bin"))
  call check("a missing file reads empty", bytes_count(gone) = 0)
  call check("and says why", last_error_code() <> 0)

  call check("cleaned up the blob", file_delete(blob))

  # --- tidy up ------------------------------------------------------------
  if file_delete(moved) and file_delete(note) and dir_delete(dir)
    call print_text("cleaned up")
  end
  if not dir_exists(dir)
    call print_text("the scratch directory is gone")
  end
end
