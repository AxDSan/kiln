# Both halves of 0.7.0 in one program: bits choose the function, and an address
# is what gets called.
#
# `libops.so` is opened while this program runs and is not declared anywhere —
# its five exports are fetched by name into a table of pointers, exactly as a
# COM vtable holds them. A request word says which of the five to run: bit one
# is slot one, and `flags band (1 shl (slot - 1))` is how a bit is tested.
# Each slot is C's own operator, so what `call through` brings back is checked
# against what `band`, `bor`, `bxor`, `shl` and `ushr` compute here.
#
# Build the plug-in beside the binary first:
#   clang -shared -fPIC -o libops.so examples/dll/ops.c
module dispatch

# The one indexable home for a `ptr`: an inline array inside a c-record.
# Kiln's own lists do not hold pointers.
record Table is c
  fn: ptr[5]
end

# The POSIX loader, which is itself a C library.
dll dlopen(path: text, mode: int): ptr from "libdl.so.2"
dll dlsym(handle: ptr, symbol: text): ptr from "libdl.so.2"
dll dlclose(handle: ptr): int from "libdl.so.2"

const RTLD_NOW = 2

# One bit per slot, written as the bit it is.
const WANT_AND  = 0b0_0001
const WANT_OR   = 0b0_0010
const WANT_XOR  = 0b0_0100
const WANT_SHL  = 0b0_1000
const WANT_USHR = 0b1_0000

# The pair every operation is given. `0xDEAD_BEEF` is 32 bits with the top one
# set, so as an `int` it is negative — which is the whole point of asking for
# `shr` against `ushr`.
const LEFT  = 0xDEAD_BEEF
const RIGHT = 4

sub name_of(slot: int): text
  match slot
  when 1: return "and"
  when 2: return "or"
  when 3: return "xor"
  when 4: return "shl"
  else: return "ushr"
  end
end

sub symbol_of(slot: int): text
  return "op_" + name_of(slot)
end

# The same five operations, computed here rather than in C.
sub native(slot: int, a: int, b: int): int
  match slot
  when 1: return a band b
  when 2: return a bor b
  when 3: return a bxor b
  when 4: return a shl b
  else: return a ushr b
  end
end

sub say(what: text, from_c: int, from_kiln: int)
  if from_c = from_kiln
    call print_text("ok {what} = {from_c}")
  else
    call print_text("FAIL {what}: C said {from_c}, Kiln said {from_kiln}")
  end
end

sub main
  let lib: ptr = dlopen("./libops.so", RTLD_NOW)
  if ptr_is_null(lib)
    call print_text("libops.so did not load")
    return
  end

  # Five addresses into five slots. Nothing here is a declared symbol.
  var vt: Table
  for slot in 1..5
    vt.fn[slot] = dlsym(lib, symbol_of(slot))
    if ptr_is_null(vt.fn[slot])
      call print_text("FAIL missing {symbol_of(slot)}")
      return
    end
  end

  # Everything except the left shift. A bit is tested, not a number compared.
  let request: int = WANT_AND bor WANT_OR bor WANT_XOR bor WANT_USHR
  for want in 1..5
    if request band (1 shl (want - 1)) = 0
      call print_text("skipped {name_of(want)}")
      continue
    end
    call say(name_of(want), call through vt.fn[want](LEFT, RIGHT): int, native(want, LEFT, RIGHT))
  end

  # `shr` is the one operation C's `>>` on a signed value does not pin down, so
  # it has no slot — it is checked against the shift it differs from instead.
  if LEFT shr RIGHT <> LEFT ushr RIGHT
    call print_text("ok shr keeps the sign where ushr does not")
  else
    call print_text("FAIL shr and ushr agreed on a negative value")
  end

  # Turning the left shift back on is one `bor`, and the slot it lights up is
  # reached the same way.
  let more: int = request bor WANT_SHL
  if more band WANT_SHL <> 0
    call say(name_of(4), call through vt.fn[4](LEFT, RIGHT): int, native(4, LEFT, RIGHT))
  end

  call print_int(dlclose(lib))
end
