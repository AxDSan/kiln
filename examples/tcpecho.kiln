// A TCP echo server with no socket anywhere in sight.
//
//   kiln build examples/tcpecho.kiln -o tcpecho
//   ./tcpecho 7000
//   nc localhost 7000        (then type lines; `quit` stops the server)
//
// The server is a component, the way `Httpserver` is: properties, events, and
// no rectangle, so it is declared at the top of the file, outside any class,
// and needs no form. Its block sets properties and wires each event to a static
// method with `+=`. `Main` sets the port from the command line — a property
// value in the block must be a literal — switches it on, and returns; the
// program stays alive because an active server is a live event source.
//
// Every event names the client it is about, as a small int counted from 1 in
// order of arrival and never reused. `Receive` fires once per line with the
// delimiter already stripped, and the Tcpserver commands take the server's
// `Name` as a string, the same way `GridCell` takes a grid's.

namespace Tcpecho;

using Kiln.Net;
using Kiln.System;

Tcpserver echo
{
    Name = "echo";
    Connect += OnConnect;
    Disconnect += OnDisconnect;
    Receive += OnReceive;
    Error += OnError;
}

public static class Tcpecho
{
    public static void Main()
    {
        echo.Port = TextToInt(SysArg(1));
        echo.Active = true;
        Console.WriteLine($"echo server on port {echo.Port}");
    }

    public static void OnConnect(int client)
    {
        Console.WriteLine($"connect {client}");
        Console.WriteLine("  from " + TcpserverClientAddress("echo", client));
    }

    public static void OnDisconnect(int client)
    {
        Console.WriteLine($"disconnect {client}");
    }

    public static void OnReceive(int client, string data)
    {
        if (data == "quit")
        {
            TcpserverSendAll("echo", "bye\n");
            Quit();
        }
        else
        {
            TcpserverSend("echo", client, $"echo: {data}\n");
        }
    }

    // A port already in use lands here. With no `Error` handler wired the server
    // would say so on stderr and stop the program instead.
    public static void OnError(string message)
    {
        Console.WriteLine($"error: {message}");
        Quit();
    }
}
