# A colour that is not a colour is refused before the window sees it, and
# the program can ask what went wrong: `#44444` has five digits, and the
# library answers with an error instead of a syntax complaint on stderr.
#
# The bad value is assembled at run time because a literal `"#44444"` never
# gets this far: the compiler refuses it at build time. This is the check for
# the values the compiler cannot see — text read from a file, or typed in.
#
#   kiln run examples/badcolour.kiln
module badcolour
use ui

form win
  title  = "Colours"
  width  = 320
  height = 120

  label greeting
    text  = "Hello"
    left  = 20
    top   = 20
    color = "#1f2328"
  end
end

sub main
  greeting.color = "#4444" + "4"
  call print_text(last_error_text())
  call print_text(int_to_text(last_error_code()))
  greeting.color = "#4a86e8"
  call print_text(greeting.color)
end
