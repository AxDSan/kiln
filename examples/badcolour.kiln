// A colour that is not a colour is refused before the window sees it, and
// the program can ask what went wrong: `#44444` has five digits, so setting
// `greeting.Color` to it is refused, and `LastErrorText()` and
// `LastErrorCode()` say why, instead of a syntax complaint on stderr.
//
// The bad value is assembled at run time because a literal `"#44444"` never
// gets this far: the compiler refuses it at build time. This is the check for
// the values the compiler cannot see — a string read from a file, or typed in.
//
//   kiln run examples/badcolour.kiln

namespace Badcolour;

using Kiln.Ui;

public partial form Win
{
    Title = "Colours";
    Width = 320;
    Height = 120;

    Label greeting
    {
        Text = "Hello";
        Left = 20;
        Top = 20;
        Color = "#1f2328";
    }
}

public partial form Win
{
    void Main()
    {
        greeting.Color = "#4444" + "4";
        Console.WriteLine(LastErrorText());
        Console.WriteLine(IntToText(LastErrorCode()));
        greeting.Color = "#4a86e8";
        Console.WriteLine(greeting.Color);
    }
}
