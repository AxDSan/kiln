// One command, several controls.
//
// The caption, the shortcut, whether it can be invoked at all, and the code
// behind it live in the `action` — not in any of the buttons. Both buttons
// offer the same command, so disabling it greys both and renaming it renames
// both, and neither button knows the other exists.
//
// A control names the action it offers rather than pointing at it: a component
// identifier deliberately never reaches the built binary, so the action's
// `name` is what ties them together.

namespace Actions;

using Kiln.Ui;

Action saveAction
{
    Name = "save";
    Text = "Save";
    Shortcut = "ctrl+s";
    Execute += OnSave;
}

public partial form Win
{
    Title = "Actions";
    Width = 460;
    Height = 210;
    BackgroundColor = "#ffffff";

    Label status
    {
        Text = "Nothing saved yet.";
        Left = 20;
        Top = 20;
        Width = 420;
        Color = "#1f2328";
    }

    Button toolbarSave
    {
        Action = "save";
        Left = 20;
        Top = 56;
        Width = 130;
        Height = 34;
        Color = "#ffffff";
        BorderRadius = 6;
    }

    Button menuSave
    {
        Action = "save";
        Left = 170;
        Top = 56;
        Width = 130;
        Height = 34;
        Color = "#ffffff";
        BorderRadius = 6;
    }

    Button lock
    {
        Text = "Lock it";
        Left = 20;
        Top = 120;
        Width = 130;
        Height = 34;
        BackgroundColor = "#6e7781";
        Color = "#ffffff";
        BorderRadius = 6;
        Click += OnLock;
    }
}

public partial form Win
{
    int saves = 0;

    void OnSave()
    {
        saves = saves + 1;
        status.Text = $"saved {saves}";
        Console.WriteLine($"save executed, count {saves}");
    }

    void OnLock()
    {
        saveAction.Text = "Save (locked)";
        saveAction.Enabled = false;
        Console.WriteLine("the action is disabled; both buttons follow it");
    }
}
