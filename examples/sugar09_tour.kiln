// The 0.9.0 shorthands in one program: block and raw text, collection
// literals, slicing, the dot call, `let` inference, the value `if`, `enum`,
// `match`, `repeat`, `assert`, parameter defaults, named arguments, record
// literals and updates, optionals with `otherwise` and `if some`, a list built
// by a loop, `check`, and `defer`. Every one desugars to something the language
// already had, so this transcript is exactly what the longhand would print.

namespace Sugar09Tour;

public record Point(int X, int Y, string Label);

public static class Sugar09Tour
{
    public const int SeverityInfo = 1;
    public const int SeverityWarning = 2;
    public const int SeverityError = 3;
    private string trail = "";

    /// Add a word to the trail that the tour prints at the end.
    public static void Note(string what)
    {
        trail = trail + what + " ";
    }

    /// Name a severity. `match` tests one value against several, written once.
    public static string Label(int s)
    {
        if (s == SeverityInfo)
        {
            return "info";
        }
        else if (s == SeverityWarning)
        {
            return "warning";
        }
        else
        {
            return "error";
        }
    }

    /// Describe a connection. The last parameters carry defaults, so a call may
    /// leave them out — and name the ones it gives.
    public static string Connect(string host, int port = 80, int timeout = 5000)
    {
        return $"{host}:{port}, giving up after {timeout}ms";
    }

    /// Look a name up. `check` returns early when the lookup failed, handing the
    /// caller the same 0 the failing command would have.
    public static int AgeOf(Dictionary<string, int> book, string who)
    {
        int years = (book.Get(who) ?? 0);
        if (LastErrorCode() != 0)
        {
            return 0;
        }
        return years;
    }

    /// Open, work, and close — with the closing written beside the opening.
    public static int Attempt(int n)
    {
        Note("open");
        defer Note("close");
        if (n == 1)
        {
            return 10;
        }
        Note("work");
        return 20;
    }

    public static void Main()
    {
        // Three quotes open a block whose newlines are its own; holes still fire.
        string who = "Kiln";
        string banner = $"{who} 0.9.0\nthe shorthands, in one program\n";
        Console.WriteLine(Trim(banner));
        // An `r` before the quote makes a raw literal: no escapes, no holes.
        Console.WriteLine("C:\\logs\\{today}.txt");
        // A list is written out, and `a..b` takes a run of it — both ends included.
        List<string> names = ["Ada", "Grace", "Alan", "Edsger"];
        Console.WriteLine(Join(names.Slice(2, 3), ", "));
        // `x.f(a)` is `f(x, a)`: the same call, read in the order it happens.
        string messy = "  ada lovelace  ";
        Console.WriteLine(Uppercase(Trim(messy)));
        // `let` without a type takes it from the value; `if c then a else b` is the
        // choice above written where a value goes.
        let n = names.Count;
        if (!(n == 4))
        {
            AssertFailed("the tour lists four names");
        }
        string word = (n == 1 ? "name" : "names");
        Console.WriteLine($"{n} {word}");
        // An enum member is reached through the enum's name, and is an int.
        Console.WriteLine(SeverityError);
        Console.WriteLine(Label(SeverityWarning));
        // `repeat N times` is the counting loop with its counter hidden.
        foreach (var repeat1 in 1..3)
        {
            Note("tick");
        }
        Console.WriteLine(Attempt(1));
        Console.WriteLine(Attempt(2));
        // A default fills what the call leaves out; a named argument says which slot
        // it is filling, whatever order it comes in.
        Console.WriteLine(Connect("example.com"));
        Console.WriteLine(Connect("example.com", 8080));
        Console.WriteLine(Connect("localhost", 80, 250));
        // A record can be written with braces, and copied with `...`.
        let origin = new Point(0, 0, "origin");
        let moved = new Point(3, origin.Y, "moved");
        Console.WriteLine($"{origin.Label} at {origin.X},{origin.Y}");
        Console.WriteLine($"{moved.Label} at {moved.X},{moved.Y}");
        // A dictionary lookup may find nothing, so its answer is a `T?` the checker
        // will not let you read until you have said what a missing one means.
        Dictionary<string, int> ages = new Dictionary<string, int> { ["ada"] = 36, ["grace"] = 45 };
        int? ada = (ages.Get("ada") ?? 0);
        int? zed = (ages.Get("zed") ?? 0);
        Console.WriteLine((ada ?? 0));
        Console.WriteLine((zed ?? 0));
        {
            let years = ada;
            if (years != null)
            {
                Console.WriteLine($"ada is {years}");
            }
            else
            {
                Console.WriteLine("ada is not in the book");
            }
        }
        // `none` is the optional that holds nothing until something fills it.
        string? newest = null;
        foreach (var name in names)
        {
            newest = name;
        }
        Console.WriteLine((newest ?? "(nobody)"));
        // `check` inside `age_of` hands back the sentinel when the key is missing.
        Console.WriteLine(AgeOf(ages, "grace"));
        Console.WriteLine(AgeOf(ages, "zed"));
        // A list built by a loop, written where the list is wanted.
        List<int> doubled = [1, 2, 3].Select(v => v * 2);
        Console.WriteLine(Join(doubled.Select(d => IntToText(d)), ", "));
        // The keys come out in the order they went in; the sort keeps the line
        // stable whatever the filter picks — the filter is what it is showing.
        List<string> grown = ages.Keys.Where(k => ((ages.Get(k) ?? 0)) >= 40);
        grown.Sort();
        Console.WriteLine(Join(grown, ", "));
        // And the trail, which is `defer` seen from outside.
        Console.WriteLine(Trim(trail));
    }
}
