// Methods that take arguments and give something back.
//
//   kiln build examples/subs.kiln -o subs
//   ./subs
//
// A method is declared inside a class as `public static`, then its return type,
// its name, and its parameters, each written type first: `int Add(int a, int b)`.
// A method that gives nothing back returns `void`, as `Main` does.
//
// Calling one is calling anything else: `Add(2, 3)` inside an expression, or
// `Describe(4);` on its own as a statement.

namespace Subs;

public static class Subs
{
    // Parameters in, a value out.
    public static int Add(int a, int b)
    {
        return a + b;
    }

    // Parameters are immutable, so working state is an ordinary local.
    public static int Factorial(int n)
    {
        int result = 1;
        foreach (var i in 2..n)
        {
            result *= i;
        }
        return result;
    }

    // Recursion works: a method can call itself, and the compiler needs no
    // forward declaration to let it — methods may appear in any order. An early
    // `return` states the base case.
    public static int Fib(int n)
    {
        if (n < 2)
        {
            return n;
        }
        return Fib(n - 1) + Fib(n - 2);
    }

    // A trailing parameter may carry a default, so `Shout("ada")` fills in the `!`.
    public static string Shout(string who, string mark = "!")
    {
        return Uppercase(who) + mark;
    }

    public static bool IsEven(int n)
    {
        return n % 2 == 0;
    }

    // `void`: a method that does something rather than computes something. A bare
    // `return;` leaves it early.
    public static void Describe(int n)
    {
        if (n < 0)
        {
            Console.WriteLine("negative");
            return;
        }
        // `cond ? a : b` picks one of two values.
        let kind = IsEven(n) ? "even" : "odd";
        Console.WriteLine($"{n} is {kind}");
    }

    public static void Main()
    {
        Console.WriteLine(Add(2, 3));
        Console.WriteLine(Add(Add(1, 2), 4));
        Console.WriteLine(Factorial(6));
        Console.WriteLine(Fib(15));
        Console.WriteLine(Shout("ada"));
        Describe(-1);
        Describe(4);
        Describe(7);

        // A method call is an expression, so it composes like any other.
        let total = Add(Factorial(4), Fib(10));
        Console.WriteLine(total);
    }
}
