// What an event hands its handler.
//
// A timer's `Tick` event reports which tick this is, counting from 1. A handler
// may take that number as an `int` parameter or leave the parameter list empty,
// and both are ordinary static methods — the compiler makes the two agree, so
// neither one is written around the other. `counted` and `plain` are the same
// kind of component, each subscribing a handler to `Tick` with `+=`; only their
// handlers differ.
//
//   kiln build examples/eventparams.kiln -o eventparams

namespace Eventparams;

Timer counted
{
    Interval = 20;
    Tick += OnCounted;
}

Timer plain
{
    Interval = 20;
    Tick += OnPlain;
}

public static class Eventparams
{
    // How many times `OnPlain` has run; the third run ends the program.
    private int rounds = 0;

    public static void Main()
    {
        Console.WriteLine("main returned");
    }

    // Takes what the event hands over.
    public static void OnCounted(int n)
    {
        Console.WriteLine($"counted tick {n}");
    }

    // Ignores it, and says so by taking no parameter.
    public static void OnPlain()
    {
        rounds += 1;
        Console.WriteLine("plain tick");
        if (rounds >= 3)
        {
            Quit();
        }
    }
}
