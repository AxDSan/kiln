// Reading and writing JSON.
//
// A document is a handle; a place inside it is named by a dotted path —
// "user.name", "items[2].id" — because a document's shape is not known until
// it has been parsed, which is what tells one apart from a `record`.
//
//   kiln run examples/jsonlib.kiln

namespace Jsonlib;

using Kiln.Json;

public static class Jsonlib
{
    public static void Main()
    {
        // --- reading ---------------------------------------------------------
        // A raw literal keeps every brace a brace, so the JSON reads exactly as it
        // would in a file — no interpolation holes to escape.
        let src = "{\"user\":{\"name\":\"Ada\",\"age\":36,\"admin\":true},\"items\":[{\"id\":10},{\"id\":20},{\"id\":30}],\"ratio\":0.5}";
        let doc = JsonParse(src);
        if (doc == 0)
        {
            Console.WriteLine($"parse failed: {LastErrorText()}");
        }
        Console.WriteLine(JsonGetText(doc, "user.name"));
        Console.WriteLine(JsonGetInt(doc, "user.age"));
        Console.WriteLine(JsonGetDouble(doc, "ratio"));
        Console.WriteLine(JsonGetInt(doc, "items[1].id"));
        Console.WriteLine(JsonCount(doc, "items"));
        Console.WriteLine(JsonType(doc, "user"));
        Console.WriteLine(JsonType(doc, "items[0]"));
        Console.WriteLine(JsonType(doc, "user.nickname"));
        if (JsonGetBool(doc, "user.admin"))
        {
            Console.WriteLine("admin: yes");
        }
        else
        {
            Console.WriteLine("admin: no");
        }
        if (JsonHas(doc, "user.email"))
        {
            Console.WriteLine("has an email");
        }
        else
        {
            Console.WriteLine("no email");
        }
        // The member names of an object, by position.
        foreach (var i in 1..JsonCount(doc, "user"))
        {
            Console.WriteLine("key: " + JsonKeyAt(doc, "user", i));
        }
        // Every element of an array, the count-plus-accessor way.
        int total = 0;
        foreach (var k in 0..JsonCount(doc, "items") - 1)
        {
            total = total + JsonGetInt(doc, $"items[{k}].id");
        }
        Console.WriteLine($"total = {total}");
        // --- asking for the wrong thing --------------------------------------
        let missing = JsonGetText(doc, "user.nickname");
        Console.WriteLine($"missing -> code {LastErrorCode()}");
        Console.WriteLine(JsonGetText(doc, "user.age"));
        Console.WriteLine(LastErrorText());
        // --- building --------------------------------------------------------
        let @out = JsonNewObject();
        let ok0 = JsonSetText(@out, "name", "Kiln");
        let ok1 = JsonSetInt(@out, "version.major", 0);
        let ok2 = JsonSetInt(@out, "version.minor", 1);
        let ok3 = JsonSetBool(@out, "open", true);
        let ok4 = JsonSetDouble(@out, "score", 9.25);
        let ok5 = JsonSetArray(@out, "tags");
        let ok6 = JsonSetText(@out, "tags[0]", "rad");
        let ok7 = JsonSetText(@out, "tags[1]", "native");
        Console.WriteLine(JsonStringify(@out));
        // Removing: false with code 0 is a genuine "it was not there".
        let gone = JsonRemove(@out, "score");
        Console.WriteLine(JsonStringify(@out));
        let again = JsonRemove(@out, "score");
        Console.WriteLine($"second remove -> code {LastErrorCode()}");
        // --- round-tripping through a file -----------------------------------
        let saved = JsonSave(@out, "/tmp/kiln_jsonlib.json");
        let back = JsonParseFile("/tmp/kiln_jsonlib.json");
        Console.WriteLine(JsonGetText(back, "name"));
        Console.WriteLine(JsonGetInt(back, "version.minor"));
        Console.WriteLine(JsonStringifyPretty(back));
        // --- malformed input is refused, with the byte offset ----------------
        let bad = JsonParse("{\"a\": 1,}");
        Console.WriteLine($"bad -> handle {bad}");
        Console.WriteLine(LastErrorText());
        let bad2 = JsonParse("[1, 2");
        Console.WriteLine(LastErrorText());
        let closed = JsonClose(doc);
        Console.WriteLine(JsonCloseAll());
    }
}
