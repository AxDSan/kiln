// Dictionaries: values found by name. Keys are text, and one dictionary holds
// one type of value.
//
//   kiln build examples/dict.kiln -o dict

namespace Dict;

public static class Dict
{
    public static void Main()
    {
        // A collection initializer, then a key added afterwards. Assigning through
        // a subscript adds the key, or replaces its value if it is already there.
        Dictionary<string, int> ages = new Dictionary<string, int> { ["Ada"] = 36, ["Alan"] = 41 };
        ages["Grace"] = 45;
        Console.WriteLine($"people: {ages.Count}");
        // Reading back. `Get` answers an `int?` — a number, or `null` when the key
        // is not there — so every read says what to do about absence. `?? 0` is
        // the fallback, and it is only used when the key is missing.
        let ada = ages.Get("Ada") ?? 0;
        Console.WriteLine($"Ada is {ada}");
        // Writing the same key again replaces its value; it does not add a second
        // entry.
        ages["Alan"] = 42;
        let alan = ages.Get("Alan") ?? 0;
        Console.WriteLine($"Alan is now {alan}");
        // A key that is NOT there answers `null`, so the fallback reads as 0 here.
        // That 0 cannot be told apart from a stored 0 — which is what `ContainsKey`
        // is for, and why a test against `null` is worth writing out when the
        // difference matters.
        let missing = ages.Get("Nobody") ?? 0;
        Console.WriteLine($"missing reads as {missing}");
        if (ages.ContainsKey("Nobody"))
        {
            Console.WriteLine("...and it was stored");
        }
        else if (ages.Get("Nobody") == null)
        {
            Console.WriteLine("...because: there is no key `Nobody`, so `Get` answered null");
        }
        // `foreach` over a dictionary deconstructs each entry into its key and its
        // value, in the order they were added — so iterating one is reproducible.
        foreach (var (who, age) in ages)
        {
            Console.WriteLine($"{who} -> {age}");
        }
        // `Remove` answers whether there was anything to remove.
        if (ages.Remove("Alan"))
        {
            Console.WriteLine($"after removing Alan: {ages.Count}");
        }
        if (ages.Remove("Alan"))
        {
            Console.WriteLine("removed twice?");
        }
        else
        {
            Console.WriteLine("removing Alan again does nothing");
        }
    }
}
