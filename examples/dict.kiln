// Dictionaries: values found by name. Keys are text, and one dictionary holds
// one type of value.

namespace Dict;

public static class Dict
{
    public static void Main()
    {
        // A literal, then a key added afterwards. `ages["Grace"] = 45` is `dict_set`
        // spelled as a subscript.
        Dictionary<string, int> ages = new Dictionary<string, int> { ["Ada"] = 36, ["Alan"] = 41 };
        ages["Grace"] = 45;
        Console.WriteLine($"people: {ages.Count}");
        // Reading back. A key that IS there clears the error slot.
        let ada = (ages.Get("Ada") ?? 0);
        Console.WriteLine($"Ada is {ada}");
        // `dict_get` and `dict_set` are the same two operations written out. The
        // subscript is sugar; either spelling reaches the same entry.
        ages["Alan"] = 42;
        let alan = (ages.Get("Alan") ?? 0);
        Console.WriteLine($"Alan is now {alan}");
        // A key that is NOT there answers the sentinel for the value type — 0 here —
        // and leaves the reason in the error slot. `dict_has` is what tells that
        // apart from a stored 0, which is why it exists.
        let missing = (ages.Get("Nobody") ?? 0);
        Console.WriteLine($"missing reads as {missing}");
        if (ages.ContainsKey("Nobody"))
        {
            Console.WriteLine("...and it was stored");
        }
        else
        {
            Console.WriteLine($"...because: {LastErrorText()}");
        }
        // `for each` over a dictionary binds the key and its value together, in the
        // order they were added — which is what makes iterating one reproducible now
        // that arrays exist.
        foreach (var (who, age) in ages)
        {
            Console.WriteLine($"{who} -> {age}");
        }
        // Removing answers whether there was anything to remove.
        if (ages.Remove("Alan"))
        {
            Console.WriteLine($"after removing Alan: {ages.Count}");
        }
        if (ages.Remove("Alan"))
        {
            Console.WriteLine("removed twice?");
        }
        else
        {
            Console.WriteLine("removing Alan again does nothing");
        }
    }
}
