// Pointers and raw memory — the escape hatch to C.
//
//   kiln build examples/ptr.kiln -o ptr
//   ./ptr
//
// A `ptr` holds a raw machine address. These are the operations that let an
// Kiln program build a buffer or a struct and hand it to a C API.

namespace Ptr;

public static class Ptr
{
    public static void Main()
    {
        // Allocate 16 bytes, write an int at offset 0 and an int64 at offset 8,
        // then read both back. Sizes and offsets are int64.
        Ptr buf = MemAlloc(16);
        MemZero(buf, 16);
        PtrWriteInt(buf, 0, 42);
        PtrWriteInt64(buf, 8, 9000000000);
        Console.WriteLine(PtrReadInt(buf, 0));
        PrintInt64(PtrReadInt64(buf, 8));
        // One byte reads as an int 0..255; a double round-trips its 8 bytes.
        PtrWriteByte(buf, 4, 255);
        Console.WriteLine(PtrReadByte(buf, 4));
        PtrWriteDouble(buf, 0, 3.5);
        Console.WriteLine(PtrReadDouble(buf, 0));
        // ptr_of_text hands a C API the char* behind a text; ptr_read_text copies
        // a C string back into a Kiln text.
        string greeting = "hello, C";
        Ptr gp = PtrOfText(greeting);
        Console.WriteLine(PtrReadText(gp));
        // ptr_read_text is the one read that is safe at null: it answers "".
        Console.WriteLine(PtrReadText(PtrNull()));
        // A two-pointer chain: cell -> leaf, walked back with ptr_read_ptr.
        Ptr cell = MemAlloc(8);
        Ptr leaf = MemAlloc(8);
        PtrWriteInt(leaf, 0, 7);
        PtrWritePtr(cell, 0, leaf);
        Ptr walked = PtrReadPtr(cell, 0);
        Console.WriteLine(PtrReadInt(walked, 0));
        // ptr_from_int / ptr_to_int round-trips an address through an int64.
        Ptr again = PtrFromInt(PtrToInt(leaf));
        Console.WriteLine(PtrReadInt(again, 0));
        // Two names for one address compare equal.
        if (again == leaf)
        {
            Console.WriteLine("same");
        }
        // The null pointer answers ptr_is_null.
        if (PtrIsNull(PtrNull()))
        {
            Console.WriteLine("null-ok");
        }
        // ptr_offset makes a pointer past the base; a write through it is visible
        // at the matching offset from the base.
        PtrWriteInt(PtrOffset(buf, 8), 0, 123);
        Console.WriteLine(PtrReadInt(buf, 8));
        // Copy a text's bytes (with its NUL) into a buffer the program owns.
        Ptr name = MemAlloc(32);
        PtrWriteText(name, 0, "Kiln");
        Console.WriteLine(PtrReadText(name));
        MemFree(buf);
        MemFree(cell);
        MemFree(leaf);
        MemFree(name);
    }
}
