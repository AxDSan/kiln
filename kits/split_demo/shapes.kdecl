# split_demo, file 1 of 2 — the record and the constants.
#
# A kit's declarations may be spread over as many `.kdecl` files as its author
# finds readable: a Win32 kit is one file per system library. Every `*.kdecl` in
# the kit directory is merged into one bundle, so what lives in which file is a
# matter of shape alone.
#
# The `dll` that names `SplitPoint` is in the OTHER file, and the record here
# resolves for it: the merged bundle is registered whole before any
# cross-reference is checked, so order across files does not matter any more
# than order within one does.

record SplitPoint is c
  x: int
  y: int
end

const SPLIT_ANSWER = 42
const SPLIT_TAG = "split_demo"
