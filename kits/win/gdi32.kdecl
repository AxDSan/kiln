dll GetStretchBltMode(hdc: ptr): int from "gdi32" system

# ---------------------------------------------------------------------------
# Drawing
# ---------------------------------------------------------------------------

# `prev` may be null when the previous position is not wanted, so it is a `ptr`
# rather than a POINT parameter — `ptr_null()` or `address of` a POINT.
dll MoveToEx(hdc: ptr, x: int, y: int, prev: ptr): int from "gdi32" system
dll LineTo(hdc: ptr, x: int, y: int): int from "gdi32" system
dll GetCurrentPositionEx(hdc: ptr, at: POINT): int from "gdi32" system

dll Rectangle(hdc: ptr, left: int, top: int, right: int, bottom: int): int from "gdi32" system
dll RoundRect(hdc: ptr, left: int, top: int, right: int, bottom: int, width: int, height: int): int from "gdi32" system
dll Ellipse(hdc: ptr, left: int, top: int, right: int, bottom: int): int from "gdi32" system
dll Arc(hdc: ptr, left: int, top: int, right: int, bottom: int, x1: int, y1: int, x2: int, y2: int): int from "gdi32" system
dll Chord(hdc: ptr, left: int, top: int, right: int, bottom: int, x1: int, y1: int, x2: int, y2: int): int from "gdi32" system
dll Pie(hdc: ptr, left: int, top: int, right: int, bottom: int, x1: int, y1: int, x2: int, y2: int): int from "gdi32" system
# An array of POINTs, so a `ptr` to bytes the program laid out — a c-record
# parameter would be one struct, not a run of them.
dll Polygon(hdc: ptr, points: ptr, count: int): int from "gdi32" system
dll Polyline(hdc: ptr, points: ptr, count: int): int from "gdi32" system
dll PolyBezier(hdc: ptr, points: ptr, count: int): int from "gdi32" system

dll SetPixel(hdc: ptr, x: int, y: int, color: int): int from "gdi32" system
dll GetPixel(hdc: ptr, x: int, y: int): int from "gdi32" system
dll SetPolyFillMode(hdc: ptr, mode: int): int from "gdi32" system
dll SetROP2(hdc: ptr, mode: int): int from "gdi32" system
dll GetROP2(hdc: ptr): int from "gdi32" system

