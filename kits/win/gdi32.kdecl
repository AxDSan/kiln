# win, the GDI32 half — Windows' graphics device interface: device contexts,
# pens, brushes, fonts, bitmaps, regions and everything that draws through them.
# Every `dll` here is an export of `gdi32.dll`, except the small block at the
# bottom, which is the device-context and paint family that Windows happens to
# export from `user32.dll` even though a GDI program cannot draw without it.
#
# ANSI entry points throughout: a call that takes a string is bound under its
# `...A` name, which is both what a program writes and the symbol gdi32 exports,
# so a Kiln `text` crosses as the C `char *` it already is. The `...W` wide
# entries take UTF-16 and are not bound here.
#
# COLORREF has no macro in Kiln, so compute one: a colour is
#     colour = red + green * 256 + blue * 65536
# with each channel 0..255 — that is exactly what C's `RGB(r,g,b)` expands to.
# Unpack the other way with `red = colour % 256`, `green = (colour / 256) % 256`,
# `blue = (colour / 65536) % 256`. Constants are written in decimal here because they
# predate the lexer's hex literals; `0x00FF_FF00` compiles now, and the hex a
# header would show is in the comment either way.
#
# BITMAPFILEHEADER is deliberately absent. It is `#pragma pack(2)` — 14 bytes,
# not the 16 that natural alignment gives — so no c-record can have its layout.
# Build one with `mem_alloc(14)`, `ptr_write_int` for its two DWORDs and a pair
# of `ptr_write_byte` for each WORD — there is no 16-bit `ptr_write`.

# ---------------------------------------------------------------------------
# Structures
# ---------------------------------------------------------------------------

# The two coordinate primitives every GDI call is written in terms of.
record POINT is c
  x: int
  y: int
end

record RECT is c
  left: int
  top: int
  right: int
  bottom: int
end

record SIZE is c
  cx: int
  cy: int
end

# What BeginPaint fills in: the DC to draw through and the rectangle Windows
# wants repainted. `rgbReserved` is a private 32-byte scratch area the system
# owns — it is here so the struct is the 72 bytes Windows expects.
record PAINTSTRUCT is c
  hdc: ptr
  erase: bool
  paint: RECT
  restore: bool
  inc_update: bool
  reserved: byte[32]
end

# GetObjectA on an HBITMAP fills this in. `planes` and `bits_pixel` are WORDs.
record BITMAP is c
  kind: int
  width: int
  height: int
  width_bytes: int
  planes: word
  bits_pixel: word
  bits: ptr
end

# CreateFontIndirectA's description of a font. `face_name` is CHAR[32], written
# a byte at a time or filled with `mem_copy(address of lf.face_name,
# ptr_of_text("Segoe UI"), 8)` — the array is not NUL-filled for you beyond the
# zero a fresh c-record starts as.
record LOGFONTA is c
  height: int
  width: int
  escapement: int
  orientation: int
  weight: int
  italic: byte
  underline: byte
  strike_out: byte
  char_set: byte
  out_precision: byte
  clip_precision: byte
  quality: byte
  pitch_and_family: byte
  face_name: byte[32]
end

# GetTextMetricsA's answer: how tall a line is, how wide a character is, and
# the rest of what laying out text needs.
record TEXTMETRICA is c
  height: int
  ascent: int
  descent: int
  internal_leading: int
  external_leading: int
  ave_char_width: int
  max_char_width: int
  weight: int
  overhang: int
  digitized_aspect_x: int
  digitized_aspect_y: int
  first_char: byte
  last_char: byte
  default_char: byte
  break_char: byte
  italic: byte
  underlined: byte
  struck_out: byte
  pitch_and_family: byte
  char_set: byte
end

# The DIB description a device-independent bitmap is created and blitted from.
record BITMAPINFOHEADER is c
  size: int
  width: int
  height: int
  planes: word
  bit_count: word
  compression: int
  size_image: int
  x_pels_per_meter: int
  y_pels_per_meter: int
  clr_used: int
  clr_important: int
end

record RGBQUAD is c
  blue: byte
  green: byte
  red: byte
  reserved: byte
end

# C declares `bmiColors[1]` and a palettised bitmap over-allocates past the end
# of the struct. This is that struct exactly; for more than one palette entry,
# `mem_alloc(size of BITMAPINFO + extra * 4)` and write through the pointer.
record BITMAPINFO is c
  header: BITMAPINFOHEADER
  colors: RGBQUAD[1]
end

# CreateBrushIndirect / GetObjectA on an HBRUSH. `hatch` is a ULONG_PTR: an
# HS_* number for a hatch brush, an HBITMAP for a pattern brush — pointer-wide
# either way, so it is a `ptr` and a hatch index goes in with `ptr_from_int`.
record LOGBRUSH is c
  style: int
  color: int
  hatch: ptr
end

# CreatePenIndirect / GetObjectA on an HPEN. `width` is a POINT because the
# original API carried an x and a y width; only x is used.
record LOGPEN is c
  style: int
  width: POINT
  color: int
end

# The 2-D affine transform SetWorldTransform applies, in single-precision
# floats — read and written as doubles, stored as the 4-byte floats C declares.
record XFORM is c
  m11: float
  m12: float
  m21: float
  m22: float
  dx: float
  dy: float
end

# StartDocA's description of a print job.
record DOCINFOA is c
  cb_size: int
  doc_name: text
  output: text
  data_type: text
  kind: int
end

# ---------------------------------------------------------------------------
# Device contexts and GDI objects
# ---------------------------------------------------------------------------

dll CreateCompatibleDC(hdc: ptr): ptr from "gdi32" system
dll CreateDCA(driver: text, device: text, port: text, mode: ptr): ptr from "gdi32" system
dll DeleteDC(hdc: ptr): int from "gdi32" system
dll SaveDC(hdc: ptr): int from "gdi32" system
dll RestoreDC(hdc: ptr, saved: int): int from "gdi32" system
dll GetDeviceCaps(hdc: ptr, index: int): int from "gdi32" system
dll GdiFlush(): int from "gdi32" system

dll SelectObject(hdc: ptr, obj: ptr): ptr from "gdi32" system
dll DeleteObject(obj: ptr): int from "gdi32" system
dll GetStockObject(index: int): ptr from "gdi32" system
# `out` receives a BITMAP, a LOGPEN, a LOGBRUSH or a LOGFONTA depending on what
# `obj` is, so it is a plain `ptr` — pass `address of` the record that fits.
dll GetObjectA(obj: ptr, bytes: int, out: ptr): int from "gdi32" system
dll GetObjectType(obj: ptr): int from "gdi32" system

