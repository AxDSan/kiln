# ---------------------------------------------------------------------------
# The DC and paint family, which lives in user32.dll
#
# These six are not gdi32 exports, but no GDI program can reach a screen
# without them: they are what hands out the device context everything above
# draws through. If user32.kdecl declares any of them, one copy has to go — a
# name is unique across the whole kit — and this block is the one to cut.
# ---------------------------------------------------------------------------

dll GetDC(hwnd: ptr): ptr from "user32" system
dll GetWindowDC(hwnd: ptr): ptr from "user32" system
dll ReleaseDC(hwnd: ptr, hdc: ptr): int from "user32" system
dll BeginPaint(hwnd: ptr, paint: PAINTSTRUCT): ptr from "user32" system
dll EndPaint(hwnd: ptr, paint: PAINTSTRUCT): int from "user32" system
dll FillRect(hdc: ptr, box: RECT, brush: ptr): int from "user32" system

