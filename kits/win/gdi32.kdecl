# Constants
# ---------------------------------------------------------------------------

# Raster operations for BitBlt, StretchBlt and PatBlt.
const SRCCOPY = 13369376        # 0x00CC0020
const SRCPAINT = 15597702       # 0x00EE0086
const SRCAND = 8913094          # 0x008800C6
const SRCINVERT = 6684742       # 0x00660046
const SRCERASE = 4457256        # 0x00440328
const NOTSRCCOPY = 3342344      # 0x00330008
const NOTSRCERASE = 1114278     # 0x001100A6
const MERGECOPY = 12583114      # 0x00C000CA
const MERGEPAINT = 12255782     # 0x00BB0226
const PATCOPY = 15728673        # 0x00F00021
const PATPAINT = 16452105       # 0x00FB0A09
const PATINVERT = 5898313       # 0x005A0049
const DSTINVERT = 5570569       # 0x00550009
const BLACKNESS = 66            # 0x00000042
const WHITENESS = 16711778      # 0x00FF0062
const CAPTUREBLT = 1073741824   # 0x40000000, OR'd into a BitBlt rop

# Background mode, for SetBkMode.
