dll CreatePen(style: int, width: int, color: int): ptr from "gdi32" system
dll CreatePenIndirect(spec: LOGPEN): ptr from "gdi32" system
dll SetDCBrushColor(hdc: ptr, color: int): int from "gdi32" system
dll SetDCPenColor(hdc: ptr, color: int): int from "gdi32" system

dll CreateFontA(height: int, width: int, escapement: int, orientation: int, weight: int, italic: int, underline: int, strike_out: int, char_set: int, out_precision: int, clip_precision: int, quality: int, pitch_and_family: int, face: text): ptr from "gdi32" system
dll CreateFontIndirectA(spec: LOGFONTA): ptr from "gdi32" system

