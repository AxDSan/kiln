dll CreateCompatibleBitmap(hdc: ptr, width: int, height: int): ptr from "gdi32" system
dll CreateBitmap(width: int, height: int, planes: int, bits_pixel: int, bits: ptr): ptr from "gdi32" system
# `bits` is an out-parameter: a `void **` the call writes the pixel address to.
dll CreateDIBSection(hdc: ptr, info: ptr, usage: int, bits: ptr, section: ptr, offset: int): ptr from "gdi32" system
dll SetDIBits(hdc: ptr, bitmap: ptr, start: int, lines: int, bits: ptr, info: ptr, usage: int): int from "gdi32" system
dll GetDIBits(hdc: ptr, bitmap: ptr, start: int, lines: int, bits: ptr, info: ptr, usage: int): int from "gdi32" system
dll StretchDIBits(hdc: ptr, xdest: int, ydest: int, wdest: int, hdest: int, xsrc: int, ysrc: int, wsrc: int, hsrc: int, bits: ptr, info: ptr, usage: int, rop: int): int from "gdi32" system

dll BitBlt(hdc: ptr, x: int, y: int, width: int, height: int, src: ptr, xsrc: int, ysrc: int, rop: int): int from "gdi32" system
dll StretchBlt(hdc: ptr, x: int, y: int, width: int, height: int, src: ptr, xsrc: int, ysrc: int, wsrc: int, hsrc: int, rop: int): int from "gdi32" system
dll PatBlt(hdc: ptr, x: int, y: int, width: int, height: int, rop: int): int from "gdi32" system
