# win, kernel32 — processes, threads, the tool-help snapshots and the
# synchronisation objects. Every line here resolves in KERNEL32.DLL, the entry
# points are the ANSI (`...A`) ones where a name has two spellings, and every
# call carries `system` because that is the Win32 convention.
#
# How a Win32 type is written here:
#
#   HANDLE, HMODULE, HINSTANCE, LPVOID, any pointer   ->  ptr
#   DWORD, UINT, BOOL, LONG, int                      ->  int   (BOOL -> bool)
#   SIZE_T, ULONG_PTR, __int64                        ->  int64 (or ptr, where
#                                                              it holds an id)
#   LPSTR / LPCSTR that a program always supplies     ->  text
#   LPSTR / LPCSTR that is routinely NULL             ->  ptr
#   a struct pointer                                  ->  the c-record itself
#
# A `ptr` string parameter is the nullable one: pass `ptr_null()` for NULL, or
# `ptr_of_text("...")` for a string. A c-record parameter passes the record's
# address, so `call Process32First(snap, entry)` hands C `&entry`.
#
# DWORD constants whose top bit is set are written as the 32-bit signed number
# with the same bits — `INFINITE` is 0xFFFFFFFF, which is -1 in a 32-bit int,
# and that is what the parameter carries.

# --- structures ----------------------------------------------------------

# SECURITY_ATTRIBUTES: 24 bytes. Handed to every Create* call that can make an
# inheritable object; the descriptor is a `ptr` because it is almost always
# NULL, and a program that wants a real one builds it through advapi32.
record SECURITY_ATTRIBUTES is c
  nLength: int
  lpSecurityDescriptor: ptr
  bInheritHandle: bool
end

# STARTUPINFOA: 104 bytes. `cb` must be set to that size before CreateProcessA
# reads it. `lpReserved` and `lpReserved2` are `ptr` rather than `text` because
# Windows requires them to be NULL.
record STARTUPINFOA is c
  cb: int
  lpReserved: ptr
  lpDesktop: text
  lpTitle: text
  dwX: int
  dwY: int
  dwXSize: int
  dwYSize: int
  dwXCountChars: int
  dwYCountChars: int
  dwFillAttribute: int
  dwFlags: int
  wShowWindow: word
  cbReserved2: word
  lpReserved2: ptr
  hStdInput: ptr
  hStdOutput: ptr
  hStdError: ptr
end

# PROCESS_INFORMATION: 24 bytes. CreateProcessA fills it, and both handles in
# it are the caller's to close.
record PROCESS_INFORMATION is c
  hProcess: ptr
  hThread: ptr
  dwProcessId: int
  dwThreadId: int
end

# PROCESSENTRY32: 304 bytes, the ANSI tool-help entry. `dwSize` must be set to
# 304 before the first Process32First. `th32DefaultHeapID` is a ULONG_PTR, so
# it is a `ptr` here — that is what gives the struct its C padding. Read the
# name with `ptr_read_text(address of e.szExeFile)`.
record PROCESSENTRY32 is c
  dwSize: int
  cntUsage: int
  th32ProcessID: int
  th32DefaultHeapID: ptr
  th32ModuleID: int
  cntThreads: int
  th32ParentProcessID: int
  pcPriClassBase: int
  dwFlags: int
  szExeFile: byte[260]
end

# THREADENTRY32: 28 bytes. `dwSize` must be set to 28 before Thread32First.
record THREADENTRY32 is c
  dwSize: int
  cntUsage: int
  th32ThreadID: int
  th32OwnerProcessID: int
  tpBasePri: int
  tpDeltaPri: int
  dwFlags: int
end

# MODULEENTRY32: 568 bytes. `dwSize` must be set to 568 before Module32First.
# `szModule` is MAX_MODULE_NAME32 + 1 bytes and `szExePath` is MAX_PATH.
record MODULEENTRY32 is c
  dwSize: int
  th32ModuleID: int
  th32ProcessID: int
  GlblcntUsage: int
  ProccntUsage: int
  modBaseAddr: ptr
  modBaseSize: int
  hModule: ptr
  szModule: byte[256]
  szExePath: byte[260]
end

# CRITICAL_SECTION: 40 bytes. It is opaque — the fields are named after the
# RTL_CRITICAL_SECTION they mirror so the record has the real size AND the real
# 8-byte alignment, which a `byte[40]` would not. A program initialises it,
# enters and leaves it, and deletes it; it never reads a field.
record CRITICAL_SECTION is c
  DebugInfo: ptr
  LockCount: int
  RecursionCount: int
  OwningThread: ptr
  LockSemaphore: ptr
  SpinCount: ptr
end

# --- processes -----------------------------------------------------------

# `appName` is NULL in the common form, with the executable at the head of
# `commandLine`. `environment` inherits the caller's when NULL, and
# `currentDirectory` the caller's directory.
dll CreateProcessA(appName: ptr, commandLine: text, processAttrs: ptr, threadAttrs: ptr, inheritHandles: bool, creationFlags: int, environment: ptr, currentDirectory: ptr, startupInfo: STARTUPINFOA, processInfo: PROCESS_INFORMATION): bool from "kernel32" as "CreateProcessA" system
dll OpenProcess(desiredAccess: int, inheritHandle: bool, processId: int): ptr from "kernel32" as "OpenProcess" system
dll GetCurrentProcess(): ptr from "kernel32" as "GetCurrentProcess" system
dll GetCurrentProcessId(): int from "kernel32" as "GetCurrentProcessId" system
dll GetProcessId(process: ptr): int from "kernel32" as "GetProcessId" system
dll TerminateProcess(process: ptr, exitCode: int): bool from "kernel32" as "TerminateProcess" system
# `exitCode` is an out-parameter: a 4-byte buffer the call fills.
dll GetExitCodeProcess(process: ptr, exitCode: ptr): bool from "kernel32" as "GetExitCodeProcess" system
dll GetPriorityClass(process: ptr): int from "kernel32" as "GetPriorityClass" system
dll SetPriorityClass(process: ptr, priorityClass: int): bool from "kernel32" as "SetPriorityClass" system
dll IsWow64Process(process: ptr, wow64: ptr): bool from "kernel32" as "IsWow64Process" system
dll ExitProcess(exitCode: int) from "kernel32" as "ExitProcess" system
dll GetCommandLineA(): text from "kernel32" as "GetCommandLineA" system
dll GetEnvironmentVariableA(name: text, buffer: ptr, size: int): int from "kernel32" as "GetEnvironmentVariableA" system
dll SetEnvironmentVariableA(name: text, value: text): bool from "kernel32" as "SetEnvironmentVariableA" system

# --- threads -------------------------------------------------------------

# `startAddress` is a LPTHREAD_START_ROUTINE: `address of` a sub declared
# `sub worker(parameter: ptr): int system`. `threadId` is a 4-byte out-buffer,
# or `ptr_null()` when the id is not wanted.
dll CreateThread(threadAttrs: ptr, stackSize: int64, startAddress: ptr, parameter: ptr, creationFlags: int, threadId: ptr): ptr from "kernel32" as "CreateThread" system
dll CreateRemoteThread(process: ptr, threadAttrs: ptr, stackSize: int64, startAddress: ptr, parameter: ptr, creationFlags: int, threadId: ptr): ptr from "kernel32" as "CreateRemoteThread" system
dll OpenThread(desiredAccess: int, inheritHandle: bool, threadId: int): ptr from "kernel32" as "OpenThread" system
dll GetCurrentThread(): ptr from "kernel32" as "GetCurrentThread" system
dll GetCurrentThreadId(): int from "kernel32" as "GetCurrentThreadId" system
dll GetThreadId(thread: ptr): int from "kernel32" as "GetThreadId" system
# Both return the previous suspend count, or -1 on failure.
dll ResumeThread(thread: ptr): int from "kernel32" as "ResumeThread" system
dll SuspendThread(thread: ptr): int from "kernel32" as "SuspendThread" system
dll TerminateThread(thread: ptr, exitCode: int): bool from "kernel32" as "TerminateThread" system
dll GetExitCodeThread(thread: ptr, exitCode: ptr): bool from "kernel32" as "GetExitCodeThread" system
dll ExitThread(exitCode: int) from "kernel32" as "ExitThread" system
dll SwitchToThread(): bool from "kernel32" as "SwitchToThread" system
dll GetThreadPriority(thread: ptr): int from "kernel32" as "GetThreadPriority" system
dll SetThreadPriority(thread: ptr, priority: int): bool from "kernel32" as "SetThreadPriority" system

# --- handles and waiting -------------------------------------------------

dll CloseHandle(hobj: ptr): bool from "kernel32" as "CloseHandle" system
dll WaitForSingleObject(hobj: ptr, milliseconds: int): int from "kernel32" as "WaitForSingleObject" system
# `handles` points at an array of `count` HANDLEs. The result is
# WAIT_OBJECT_0 + the index of the signalled one, counting from zero as
# Windows does — add 1 before using it as a Kiln position.
dll WaitForMultipleObjects(count: int, handles: ptr, waitAll: bool, milliseconds: int): int from "kernel32" as "WaitForMultipleObjects" system
dll DuplicateHandle(sourceProcess: ptr, sourceHandle: ptr, targetProcess: ptr, targetHandle: ptr, desiredAccess: int, inheritHandle: bool, options: int): bool from "kernel32" as "DuplicateHandle" system
dll GetHandleInformation(hobj: ptr, flags: ptr): bool from "kernel32" as "GetHandleInformation" system
dll SetHandleInformation(hobj: ptr, mask: int, flags: int): bool from "kernel32" as "SetHandleInformation" system

# --- tool help: walking processes, threads and modules -------------------

# CreateToolhelp32Snapshot returns INVALID_HANDLE_VALUE, not NULL, on failure:
# test it with `ptr_to_int(snap) = int_to_int64(INVALID_HANDLE_VALUE)`.
dll CreateToolhelp32Snapshot(flags: int, processId: int): ptr from "kernel32" as "CreateToolhelp32Snapshot" system
dll Process32First(snapshot: ptr, entry: PROCESSENTRY32): bool from "kernel32" as "Process32First" system
dll Process32Next(snapshot: ptr, entry: PROCESSENTRY32): bool from "kernel32" as "Process32Next" system
dll Thread32First(snapshot: ptr, entry: THREADENTRY32): bool from "kernel32" as "Thread32First" system
dll Thread32Next(snapshot: ptr, entry: THREADENTRY32): bool from "kernel32" as "Thread32Next" system
dll Module32First(snapshot: ptr, entry: MODULEENTRY32): bool from "kernel32" as "Module32First" system
dll Module32Next(snapshot: ptr, entry: MODULEENTRY32): bool from "kernel32" as "Module32Next" system

# --- synchronisation -----------------------------------------------------

dll CreateMutexA(attrs: ptr, initialOwner: bool, name: ptr): ptr from "kernel32" as "CreateMutexA" system
dll OpenMutexA(desiredAccess: int, inheritHandle: bool, name: text): ptr from "kernel32" as "OpenMutexA" system
dll ReleaseMutex(mutex: ptr): bool from "kernel32" as "ReleaseMutex" system
dll CreateEventA(attrs: ptr, manualReset: bool, initialState: bool, name: ptr): ptr from "kernel32" as "CreateEventA" system
dll OpenEventA(desiredAccess: int, inheritHandle: bool, name: text): ptr from "kernel32" as "OpenEventA" system
dll SetEvent(eventHandle: ptr): bool from "kernel32" as "SetEvent" system
dll ResetEvent(eventHandle: ptr): bool from "kernel32" as "ResetEvent" system
dll PulseEvent(eventHandle: ptr): bool from "kernel32" as "PulseEvent" system
dll CreateSemaphoreA(attrs: ptr, initialCount: int, maximumCount: int, name: ptr): ptr from "kernel32" as "CreateSemaphoreA" system
dll OpenSemaphoreA(desiredAccess: int, inheritHandle: bool, name: text): ptr from "kernel32" as "OpenSemaphoreA" system
# `previousCount` is a 4-byte out-buffer, or `ptr_null()`.
dll ReleaseSemaphore(semaphore: ptr, releaseCount: int, previousCount: ptr): bool from "kernel32" as "ReleaseSemaphore" system
dll InitializeCriticalSection(section: CRITICAL_SECTION) from "kernel32" as "InitializeCriticalSection" system
dll InitializeCriticalSectionAndSpinCount(section: CRITICAL_SECTION, spinCount: int): bool from "kernel32" as "InitializeCriticalSectionAndSpinCount" system
dll EnterCriticalSection(section: CRITICAL_SECTION) from "kernel32" as "EnterCriticalSection" system
dll TryEnterCriticalSection(section: CRITICAL_SECTION): bool from "kernel32" as "TryEnterCriticalSection" system
dll LeaveCriticalSection(section: CRITICAL_SECTION) from "kernel32" as "LeaveCriticalSection" system
dll DeleteCriticalSection(section: CRITICAL_SECTION) from "kernel32" as "DeleteCriticalSection" system
dll Sleep(milliseconds: int) from "kernel32" as "Sleep" system
dll SleepEx(milliseconds: int, alertable: bool): int from "kernel32" as "SleepEx" system
dll GetTickCount(): int from "kernel32" as "GetTickCount" system

# --- access rights for OpenProcess ---------------------------------------

const PROCESS_TERMINATE = 1
const PROCESS_CREATE_THREAD = 2
const PROCESS_SET_SESSIONID = 4
const PROCESS_VM_OPERATION = 8
const PROCESS_VM_READ = 16
const PROCESS_VM_WRITE = 32
const PROCESS_DUP_HANDLE = 64
const PROCESS_CREATE_PROCESS = 128
const PROCESS_SET_QUOTA = 256
const PROCESS_SET_INFORMATION = 512
const PROCESS_QUERY_INFORMATION = 1024
const PROCESS_SUSPEND_RESUME = 2048
const PROCESS_QUERY_LIMITED_INFORMATION = 4096
# 0x001FFFFF — every right, as Windows Vista and later define it.
const PROCESS_ALL_ACCESS = 2097151

# --- access rights for OpenThread ----------------------------------------

const THREAD_TERMINATE = 1
const THREAD_SUSPEND_RESUME = 2
const THREAD_GET_CONTEXT = 8
const THREAD_SET_CONTEXT = 16
const THREAD_SET_INFORMATION = 32
const THREAD_QUERY_INFORMATION = 64
const THREAD_SET_THREAD_TOKEN = 128
const THREAD_IMPERSONATE = 256
const THREAD_ALL_ACCESS = 2097151

# The right to wait on an object. OpenProcess needs it before the handle it
# returns may be given to WaitForSingleObject.
const SYNCHRONIZE = 1048576

# --- waiting -------------------------------------------------------------

# 0xFFFFFFFF: wait until the object is signalled, however long that takes.
const INFINITE = -1
const WAIT_OBJECT_0 = 0
const WAIT_ABANDONED = 128
const WAIT_ABANDONED_0 = 128
const WAIT_TIMEOUT = 258
const WAIT_IO_COMPLETION = 192
# 0xFFFFFFFF again, as a result this time.
const WAIT_FAILED = -1
const MAXIMUM_WAIT_OBJECTS = 64

# --- tool-help snapshot flags --------------------------------------------

const TH32CS_SNAPHEAPLIST = 1
const TH32CS_SNAPPROCESS = 2
const TH32CS_SNAPTHREAD = 4
const TH32CS_SNAPMODULE = 8
const TH32CS_SNAPMODULE32 = 16
# HEAPLIST + PROCESS + THREAD + MODULE.
const TH32CS_SNAPALL = 15
# 0x80000000.
const TH32CS_INHERIT = -2147483648

# --- CreateProcessA flags ------------------------------------------------

const DEBUG_PROCESS = 1
const DEBUG_ONLY_THIS_PROCESS = 2
const CREATE_SUSPENDED = 4
const DETACHED_PROCESS = 8
const CREATE_NEW_CONSOLE = 16
const CREATE_NEW_PROCESS_GROUP = 512
const CREATE_UNICODE_ENVIRONMENT = 1024
const CREATE_BREAKAWAY_FROM_JOB = 16777216
# 0x08000000 — a console program that opens no console window.
const CREATE_NO_WINDOW = 134217728

# --- process priority classes --------------------------------------------

const NORMAL_PRIORITY_CLASS = 32
const IDLE_PRIORITY_CLASS = 64
const HIGH_PRIORITY_CLASS = 128
const REALTIME_PRIORITY_CLASS = 256
const BELOW_NORMAL_PRIORITY_CLASS = 16384
const ABOVE_NORMAL_PRIORITY_CLASS = 32768

# --- thread priorities ---------------------------------------------------

const THREAD_PRIORITY_IDLE = -15
const THREAD_PRIORITY_LOWEST = -2
const THREAD_PRIORITY_BELOW_NORMAL = -1
const THREAD_PRIORITY_NORMAL = 0
const THREAD_PRIORITY_ABOVE_NORMAL = 1
const THREAD_PRIORITY_HIGHEST = 2
const THREAD_PRIORITY_TIME_CRITICAL = 15

# --- STARTUPINFOA.dwFlags ------------------------------------------------

const STARTF_USESHOWWINDOW = 1
const STARTF_USESIZE = 2
const STARTF_USEPOSITION = 4
const STARTF_USECOUNTCHARS = 8
const STARTF_USEFILLATTRIBUTE = 16
const STARTF_USESTDHANDLES = 256

# --- handles -------------------------------------------------------------

# GetExitCodeProcess and GetExitCodeThread report this while the process or
# thread is still running.
const STILL_ACTIVE = 259
# (HANDLE)-1. It is an `int` constant, and `ptr_to_int` gives an `int64`, so
# the comparison is written
# `ptr_to_int(h) = int_to_int64(INVALID_HANDLE_VALUE)`; a handle of that value
# is made with `ptr_from_int(INVALID_HANDLE_VALUE)`.
const INVALID_HANDLE_VALUE = -1
const HANDLE_FLAG_INHERIT = 1
const HANDLE_FLAG_PROTECT_FROM_CLOSE = 2
const DUPLICATE_CLOSE_SOURCE = 1
const DUPLICATE_SAME_ACCESS = 2

# --- the sizes a `dwSize`/`cb` field must be given ------------------------
#
# These are the same numbers `size of` reports; they are here so a program can
# write `e.dwSize = SIZEOF_PROCESSENTRY32` without an int64-to-int conversion.

const SIZEOF_STARTUPINFOA = 104
const SIZEOF_PROCESS_INFORMATION = 24
const SIZEOF_PROCESSENTRY32 = 304
const SIZEOF_THREADENTRY32 = 28
const SIZEOF_MODULEENTRY32 = 568
const SIZEOF_CRITICAL_SECTION = 40
const SIZEOF_SECURITY_ATTRIBUTES = 24
