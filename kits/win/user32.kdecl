dll InflateRect(rect: RECT, dx: int, dy: int): bool from "user32" system
# PtInRect is left out: C spells it `PtInRect(const RECT *, POINT)`, and the
# POINT is by value, which a c-record parameter can never be. Write the four
# comparisons — `x >= r.left and x < r.right and y >= r.top and y < r.bottom`
# — which is what PtInRect does.

