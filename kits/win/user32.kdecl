# The hook procedure is `address of` a sub shaped
#   sub hook(code: int, wparam: int64, lparam: int64): int64 system
# which returns CallNextHookEx(...) for anything it does not handle. A
# WH_KEYBOARD_LL or WH_MOUSE_LL hook is global: `hmod` may be NULL and
# `thread_id` 0, and the thread that installs it must pump messages.
dll SetWindowsHookExA(hook_id: int, hook_proc: ptr, hmod: ptr, thread_id: int): ptr from "user32" system
dll CallNextHookEx(hook: ptr, code: int, wparam: int64, lparam: int64): int64 from "user32" system
dll UnhookWindowsHookEx(hook: ptr): bool from "user32" system

dll RegisterHotKey(hwnd: ptr, hotkey_id: int, modifiers: int, key: int): bool from "user32" system
dll UnregisterHotKey(hwnd: ptr, hotkey_id: int): bool from "user32" system

# `inputs` is `address of` an INPUT (or the first of an array of them) and
# `size` is `int64_to_int(size of INPUT)` — 40, both arms.
dll SendInput(count: int, inputs: ptr, size: int): int from "user32" system
# The legacy pair. Their first arguments are BYTEs in C; an `int` argument
# arrives in the same register and the callee reads its low byte.
dll keybd_event(vk: int, scan: int, flags: int, extra_info: int64) from "user32" system
dll mouse_event(flags: int, dx: int, dy: int, data: int, extra_info: int64) from "user32" system

dll SetCapture(hwnd: ptr): ptr from "user32" system
dll ReleaseCapture(): bool from "user32" system
