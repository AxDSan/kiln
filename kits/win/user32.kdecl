# win, user32 — the USER32.DLL half of the Win32 kit: windows, messages,
# dialogs, input, hooks, the clipboard, menus, and the painting calls that
# live in user32 rather than gdi32 (BeginPaint, FillRect, DrawTextA, GetDC).
#
# Every entry that takes or answers a string is the ANSI (`...A`) one, and
# every line is reached with the `system` convention. Windows only — the kit's
# lib.json gates it to `"windows"`.
#
# Reading the transcriptions:
#
#   - A handle (HWND, HINSTANCE, HMENU, HDC, HICON, HCURSOR, HBRUSH, HHOOK,
#     HGLOBAL, LPVOID, and any struct pointer that may be NULL) is `ptr`.
#     `ptr_null()` is the NULL a C caller writes.
#   - WPARAM, LPARAM and LRESULT are integer payloads, so they are `int64`.
#     A handle that travels *in* a WPARAM/LPARAM is `ptr_to_int(h)` at the
#     call site, and `ptr_from_int(v)` coming back.
#   - DWORD, UINT, BOOL, int and ATOM are `int`. An ATOM and a SHORT return
#     only define their low 16 bits; test the bits you want rather than the
#     sign of the whole word.
#   - LPCSTR is `text` where the API always wants a string. Where NULL is the
#     ordinary call (FindWindowA's second argument) or the argument is really
#     a MAKEINTRESOURCE number (LoadCursorA, LoadIconA), the parameter is
#     `ptr` and a `...NameA`/`...ByNameA` sibling under `as` gives the string
#     form. Pass `ptr_from_int(IDC_ARROW)` for a resource id — a bare constant
#     is an integer literal and fits `ptr_from_int`'s `int64` directly, but an
#     expression built from constants is an `int`, so that one is spelled
#     `ptr_from_int(int_to_int64(COLOR_WINDOW + 1))`. The same widening goes
#     the other way for a `size of` handed to an `int` parameter:
#     `int64_to_int(size of INPUT)`.
#   - A struct that the callee fills in is declared as its c-record, so the
#     record is handed over as a pointer automatically. A struct pointer that
#     is *optionally* NULL (InvalidateRect's rect) stays `ptr`, so
#     `address of r` or `ptr_null()` both fit.
#   - The HWND_* and GWLP_* constants are numbers used as pointers or as
#     signed indices: `ptr_from_int(HWND_MESSAGE)`, `GWLP_USERDATA` as is.
#
# Not expressible here, and why:
#
#   - WindowFromPoint and ChildWindowFromPoint take a POINT *by value*. A
#     c-record parameter is always a pointer, so they are left out rather
#     than transcribed wrongly.
#   - INPUT is a union. Its two useful arms are declared as two records that
#     both measure 40 bytes — the real sizeof(INPUT) — so SendInput's `size`
#     argument is right whichever arm is filled in.

# ---------------------------------------------------------------- structures

# POINT, RECT, SIZE and PAINTSTRUCT are windef.h shapes that belong to no one
# DLL. This kit declares them once, in `gdi32.kdecl`, and every signature below
# that names one uses that declaration — a kit's records share one namespace,
# so there is exactly one RECT in `use win`.
#
# For reference, the fields those four carry:
#   POINT       x, y
#   RECT        left, top, right, bottom
#   SIZE        cx, cy
#   PAINTSTRUCT hdc, erase, paint, restore, inc_update, reserved
#
# GetDC, GetWindowDC, ReleaseDC, BeginPaint, EndPaint and FillRect are user32
# exports that `gdi32.kdecl` declares, because they are only ever called beside
# the GDI drawing calls. They are not repeated here.

# MSG — 48 bytes: hwnd@0, message@8, wparam@16, lparam@24, time@32, pt@36.
record MSG is c
  hwnd: ptr
  message: int
  wparam: int64
  lparam: int64
  time: int
  pt: POINT
end

# WNDCLASSEXA — 80 bytes. `cb_size` must be set to `size of WNDCLASSEXA`
# before RegisterClassExA, which is how the API versions the struct.
# `wnd_proc` is `address of` a sub shaped like a WNDPROC:
#   sub wndproc(hwnd: ptr, msg: int, wparam: int64, lparam: int64): int64 system
# `background` is conventionally
# `ptr_from_int(int_to_int64(COLOR_WINDOW + 1))`.
record WNDCLASSEXA is c
  cb_size: int
  style: int
  wnd_proc: ptr
  cls_extra: int
  wnd_extra: int
  instance: ptr
  icon: ptr
  cursor: ptr
  background: ptr
  menu_name: text
  class_name: text
  icon_sm: ptr
end

# WNDCLASSA — the older, 72-byte form RegisterClassA takes. No cbSize, no
# small icon.
record WNDCLASSA is c
  style: int
  wnd_proc: ptr
  cls_extra: int
  wnd_extra: int
  instance: ptr
  icon: ptr
  cursor: ptr
  background: ptr
  menu_name: text
  class_name: text
end

# CREATESTRUCTA — 80 bytes. WM_NCCREATE and WM_CREATE arrive with its address
# in LPARAM: `var cs: CREATESTRUCTA` cannot receive that, so read it through
# `ptr_from_int(lparam)` and the offsets, or copy it with mem_copy.
record CREATESTRUCTA is c
  create_params: ptr
  instance: ptr
  menu: ptr
  parent: ptr
  cy: int
  cx: int
  y: int
  x: int
  style: int
  name: text
  class_name: text
  ex_style: int
end

# MINMAXINFO — 40 bytes, the struct WM_GETMINMAXINFO points at.
record MINMAXINFO is c
  reserved: POINT
  max_size: POINT
  max_position: POINT
  min_track_size: POINT
  max_track_size: POINT
end

# WINDOWPLACEMENT — 44 bytes. `length` must be `size of WINDOWPLACEMENT`.
record WINDOWPLACEMENT is c
  length: int
  flags: int
  show_cmd: int
  min_position: POINT
  max_position: POINT
  normal_position: RECT
end

# WINDOWPOS — 40 bytes, what WM_WINDOWPOSCHANGING/CHANGED point at.
record WINDOWPOS is c
  hwnd: ptr
  insert_after: ptr
  x: int
  y: int
  cx: int
  cy: int
  flags: int
end

# KBDLLHOOKSTRUCT — 24 bytes. LPARAM of a WH_KEYBOARD_LL hook points at one.
record KBDLLHOOKSTRUCT is c
  vk_code: int
  scan_code: int
  flags: int
  time: int
  extra_info: int64
end

# MSLLHOOKSTRUCT — 32 bytes: pt@0, mouse_data@8, flags@12, time@16,
# extra_info@24. LPARAM of a WH_MOUSE_LL hook points at one.
record MSLLHOOKSTRUCT is c
  pt: POINT
  mouse_data: int
  flags: int
  time: int
  extra_info: int64
end

# CWPSTRUCT — 32 bytes, the LPARAM of a WH_CALLWNDPROC hook.
record CWPSTRUCT is c
  lparam: int64
  wparam: int64
  message: int
  hwnd: ptr
end

record MOUSEINPUT is c
  dx: int
  dy: int
  mouse_data: int
  flags: int
  time: int
  extra_info: int64
end

record KEYBDINPUT is c
  vk: word
  scan: word
  flags: int
  time: int
  extra_info: int64
end

# INPUT with the KEYBDINPUT arm of its union selected. `union_tail` is the
# rest of the union — MOUSEINPUT is the widest arm — so this record is the
# real 40-byte sizeof(INPUT) that SendInput's third argument must be given.
# Set `kind` to INPUT_KEYBOARD.
record INPUT is c
  kind: int
  ki: KEYBDINPUT
  union_tail: byte[8]
end

# The same 40-byte INPUT with the MOUSEINPUT arm selected. Set `kind` to
# INPUT_MOUSE. Both records are `size of` 40; an array of either is a valid
# SendInput batch of that one kind.
record INPUTMOUSE is c
  kind: int
  mi: MOUSEINPUT
end

