dll InvertRect(dc: ptr, rect: RECT): bool from "user32" system
# `count` of -1 means "to the NUL".
dll DrawTextA(dc: ptr, body: text, count: int, rect: RECT, format: int): int from "user32" system
dll DrawFocusRect(dc: ptr, rect: RECT): bool from "user32" system
dll SetRect(rect: RECT, left: int, top: int, right: int, bottom: int): bool from "user32" system
